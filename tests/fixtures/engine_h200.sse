data: {"event": {"type": "status", "data": {"description": "\u2192 5 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432: \"\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430\", \"\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445\" \u0438 \u0435\u0449\u0451 3", "done": false}}}

data: {"event": {"type": "status", "data": {"description": "\ud83d\udcc4 [H200 \u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u0430 NVIDIA] \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0447\u0442\u0435\u043d\u0438\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430: \u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445", "done": false}}}

data: {"event": {"type": "status", "data": {"description": "\u2192 1 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442: \"\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445\"", "done": false}}}

data: {"event": {"type": "status", "data": {"description": "\ud83d\udcc4 [H200 \u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u0430 NVIDIA Selectel] \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0447\u0442\u0435\u043d\u0438\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430: \u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u211615: Intel \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439 \u0447\u0438\u043f \u00b7 nVIDIA, OpenAI \u0438 \u0432\u0441\u0435-\u0432\u0441\u0435-\u0432\u0441\u0435 \u00b7 \u043f\u043e\u0436\u0430\u0440 \u0432 \u0426\u041e\u0414", "done": false}}}

