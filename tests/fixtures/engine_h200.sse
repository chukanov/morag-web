data: {"event": {"type": "status", "data": {"description": "\ud83d\udcc4 [H200 \u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u0430 NVIDIA \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043c\u043e\u0434\u0435\u043b\u0435\u0439] \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0447\u0442\u0435\u043d\u0438\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430: \u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430", "done": false}}}

data: {"event": {"type": "status", "data": {"description": "\u2192 1 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442: \"\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430\"", "done": false}}}

data: {"event": {"type": "status", "data": {"description": "\u2705 \u041d\u0430\u0439\u0434\u0435\u043d\u043e 5 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0437\u0430 5 \u0448\u0430\u0433\u043e\u0432", "done": true}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[37:07] [\u0414\u0430\u043d\u0438\u044d\u043b\u044c \u0429\u0435\u0431\u0435\u043d\u0442\u043e\u0432\u0441\u043a\u0438\u0439] \u0412\u043e\u0442 \u0432\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u0443 DGX \u0442\u0430\u043c \u0432\u043e\u0441\u0435\u043c\u044c <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442</mark>. \u0410 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u043e\u043f\u0440\u043e\u0441, \u0432\u043e-\u043f\u0435\u0440\u0432\u044b\u0445, \u043a\u0430\u043a\u0438\u0445? \u041d\u0443, \u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u044c. \u0415\u0449\u0451 \u0440\u0430\u0437, \u0431\u044b\u0432\u0430\u0435\u0442 \u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u044c \u0435\u0449\u0451. \u0410, \u043d\u0443 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e, \u043a\u0430\u043a \u0431\u044b, <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u0430</mark> \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u043e\u0434\u043d\u0430, \u044d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442 \u0443\u0436\u0435 \u043c\u043d\u043e\u0433\u043e \u0438 \u0443\u0436\u0435 \u0434\u043e\u0440\u043e\u0433\u043e. \u0412\u043e\u043f\u0440\u043e\u0441. \u041a\u0430\u043a\u043e\u0433\u043e \u0440\u043e\u0434\u0430 <mark>\u043c\u043e\u0434\u0435\u043b\u0438</mark>, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u043c\u043e\u0436\u043d\u043e \u043d\u0430 \u043d\u0438\u0445 \u043e\u0431\u0443\u0447\u0438\u0442\u044c \u0441 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043d\u0443\u043b\u044f? \u0422\u043e \u0435\u0441\u0442\u044c, \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u0434\u043e\u0441\u0442\u0438\u0447\u044c, \u0433\u0440\u0443\u0431\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u0443\u0440\u043e\u0432\u043d\u044f GPT-4, GPT-5, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u043a\u0430\u043a\u0438\u0435-\u043d\u0438\u0431\u0443\u0434\u044c, \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u043e\u043e\u0431\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0435.</p>\n<p>[\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u044f \u0432\u0430\u043c \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0443 \u043d\u0435\u043c\u043d\u043e\u0436\u043a\u043e \u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e \u043e\u043f\u044b\u0442\u0430. \u041d\u0443, \u0432\u043e-\u043f\u0435\u0440\u0432\u044b\u0445, \u043e\u0442\u0432\u0435\u0447\u0430\u044f \u043d\u0430 \u0432\u0430\u0448 \u043f\u0435\u0440\u0432\u044b\u0439 \u0432\u043e\u043f\u0440\u043e\u0441 \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443 \u043a\u0430\u043a\u0438\u0435 \u043a\u0430\u0440\u0442\u044b. \u041a\u0430\u0440\u0442\u044b, \u043a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430, \u0442\u0430\u043c \u0441\u0442\u0430\u0432\u044f\u0442\u0441\u044f \u0441\u0430\u043c\u044b\u0435 \u0445\u043e\u0440\u043e\u0448\u0438\u0435. \u041d\u0443, \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u2014 <mark>H200</mark>. \u0412\u043e\u0442 DGX \u0441 <mark>H200</mark>, 8 \u0448\u0442\u0443\u043a, \u0447\u0442\u043e-\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043e\u0431\u0443\u0447\u0438\u0442\u044c. \u041d\u0430\u0434\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u043e \u043f\u0430\u043c\u044f\u0442\u0438. \u042f, \u0447\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u0441\u0445\u043e\u0434\u0443 \u043d\u0435 \u043f\u043e\u043c\u043d\u044e, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443 \u0432\u0430\u0441 280. \u0414\u0430, 80 \u043f\u0430\u043c\u044f\u0442\u0438, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e, 640 \u0433\u0438\u0433\u0430\u0431\u0430\u0439\u0442 \u043f\u0430\u043c\u044f\u0442\u0438 \u0432\u0438\u0434\u0435\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043e\u0431\u0443\u0447\u0430\u0442\u044c <mark>\u043c\u043e\u0434\u0435\u043b\u044c</mark> \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u043c, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0443\u0442 \u043c\u043e\u0436\u043d\u043e \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u0443 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e. 200B, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u0434\u0430, \u043c\u043e\u0436\u0435\u0442 \u0447\u0443\u0442\u044c \u043c\u0435\u043d\u044c\u0448\u0435. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0435\u0449\u0435 \u043f\u043b\u044e\u0441 20% \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043b\u043e\u0436\u0438\u0442\u044c \u043d\u0430 \u0432\u0435\u0449\u0438 \u043e\u0433\u043e\u0440\u043e\u0434\u0435\u043d\u0438\u044f. \u041d\u0443, \u0431\u0443\u0434\u0435\u043c \u0441\u0447\u0438\u0442\u0430\u0442\u044c, \u0441\u0442\u043e\u0438\u0442 150 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432. \u0412\u043e\u0442 \u043c\u043e\u0436\u043d\u043e \u043e\u0431\u0443\u0447\u0438\u0442\u044c <mark>\u043c\u043e\u0434\u0435\u043b\u044c</mark> \u0432\u043e\u0442 \u0442\u0430\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430. \u0418\u043c\u0435\u0435\u0442\u0441\u044f \u0442\u043e \u0441 \u0442\u0435\u043a\u0443\u0449\u0438\u043c\u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u043c\u0438, \u0435\u0441\u043b\u0438 \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u043f\u0440\u043e <mark>\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435</mark> \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u0440\u0430\u0437\u043c\u0435\u0440\u0435. \u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044d\u0442\u043e...</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season2/ep5.md#2227", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 37:07 \u00b7 \u0414\u0430\u043d\u0438\u044d\u043b\u044c \u0429\u0435\u0431\u0435\u043d\u0442\u043e\u0432\u0441\u043a\u0438\u0439, \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=2227", "citation_number": 1, "order": 23}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 37:07 \u00b7 \u0414\u0430\u043d\u0438\u044d\u043b\u044c \u0429\u0435\u0431\u0435\u043d\u0442\u043e\u0432\u0441\u043a\u0438\u0439, \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=2227"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[16:09] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0427\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u043a\u043e\u0433\u0434\u0430 \u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0440\u0430\u0437 \u043d\u0430 \u044d\u0442\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u043b, \u0432\u0441\u0451, \u0447\u0442\u043e \u043e\u043d\u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u043b\u0438, \u0431\u044b\u043b \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0431\u0430\u0434. \u041d\u043e, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u044f \u043d\u0435 \u0441\u043b\u0435\u0434\u0438\u043b \u0437\u0430 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e\u043c, \u0438 \u043e\u043d\u0438 \u0438\u0437\u043e\u0431\u0440\u0435\u043b\u0438 \u0447\u0442\u043e-\u0442\u043e \u043d\u043e\u0432\u043e\u0435 \u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e\u0435. \u0412\u043e\u0442, \u044f \u0434\u0443\u043c\u0430\u044e, \u0437\u0434\u0435\u0441\u044c \u0432\u0441\u0451 \u043e\u0431\u0441\u0443\u0434\u0438\u043b\u0438. \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u044c \u043a \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043d\u043e\u0432\u043e\u0441\u0442\u0438. \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c \u0443 \u043d\u0430\u0441 \u043f\u0440\u043e \u041a\u0438\u0442\u0430\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \u0447\u0438\u043f\u044b \u043e\u0442 <mark>NVIDIA</mark>. \u041a\u043e\u0442\u043e\u0440\u044b\u0435 H20, \u0434\u0430, \u044d\u0442\u043e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435, \u043d\u0443 \u043a\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435, \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u043d\u044b\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438 <mark>H200</mark>, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043b\u044f \u0432\u0441\u0435\u0433\u043e \u043c\u0438\u0440\u0430 \u0438 \u0434\u043b\u044f \u041a\u0438\u0442\u0430\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043e\u0442 <mark>NVIDIA</mark> \u0441\u043c\u043e\u0433\u043b\u0430 \u043f\u0440\u043e\u0434\u0430\u0432\u0438\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u0438\u0445 \u0432\u0441\u0451-\u0442\u0430\u043a\u0438 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u043b\u0438 \u0432 \u041a\u0438\u0442\u0430\u0435. \u0412\u043e\u0442 \u0441\u0435\u0439\u0447\u0430\u0441 \u041a\u0438\u0442\u0430\u0439 \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \u044d\u0442\u0438 \u0447\u0438\u043f\u044b, \u043e\u043d\u0438 \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0438 \u0412\u0440\u043e\u0434\u0435 \u043a\u0430\u043a \u043e\u0442\u0441\u044b\u043b\u0430\u044e\u0442 \u043a\u0430\u043a\u0443\u044e-\u0442\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e, \u043d\u0435 \u043f\u043e\u0439\u043c\u0438 \u043a\u0443\u0434\u0430, \u0438 \u0437\u0430 \u0441\u0447\u0451\u0442 \u044d\u0442\u043e\u0433\u043e, \u0432 \u043e\u0431\u0449\u0435\u043c, \u0438\u043c \u044d\u0442\u043e \u043d\u0435 \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \u0412\u043e\u0442, \u044f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u044d\u0442\u043e, \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u043f\u043e\u0445\u043e\u0436\u0435 \u043d\u0430 \u043f\u0440\u0430\u0432\u0434\u0443, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e, \u0430 \u0447\u0442\u043e \u0431\u044b, \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043d\u0435 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0442\u0443\u0434\u0430 \u043a\u0430\u043a\u0438\u0435-\u043d\u0438\u0431\u0443\u0434\u044c \u0442\u0440\u0435\u043a\u0435\u0440\u044b, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432 \u043b\u044e\u0431\u043e\u0435 \u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442, \u043d\u0443, \u0432\u043e \u0432\u0441\u044f\u043a\u0438\u0435 \u0441\u0442\u0430\u043d\u043a\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0434\u0430. \u0418, \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043c\u044b \u0443\u0436\u0435 \u0432\u0438\u0434\u0435\u043b\u0438, \u043a\u0430\u043a \u0441\u0442\u0430\u043d\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c. \u0423\u0434\u0430\u043b\u0451\u043d\u043d\u043e. \u0410 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u044d\u0442\u043e\u0433\u043e \u043d\u0435\u0442, \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043c, \u0447\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u043d\u0435\u0442, \u0442\u043e \u041a\u0438\u0442\u0430\u044e \u043a\u0430\u043a \u0440\u0430\u0437 \u0432\u044b\u0433\u043e\u0434\u043d\u043e \u0440\u0430\u0437\u0434\u0443\u0432\u0430\u0442\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u0443\u044e. \u0421\u043a\u0430\u0436\u0435\u043c \u0442\u0430\u043a, \u0448\u043f\u0438\u043e\u043d\u043e\u043c\u0430\u043d\u0438\u044e, \u0434\u0430, \u0432 \u0442\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435, \u0447\u0442\u043e\u0431\u044b \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u044b \u0432\u0441\u0435 \u0434\u0440\u0443\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u0435 \u043d\u0430 \u043d\u0430\u0448\u0438 \u0442\u0438\u043f\u044b. \u041d\u0443, \u044d\u0442\u043e, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438. \u0412 \u041a\u0438\u0442\u0430\u0435 \u043d\u0430\u043f\u043e\u043c\u043d\u044e, \u0447\u0442\u043e \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u043c\u043d\u043e\u0433\u043e \u043b\u044e\u0434\u0435\u0439 \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u0438 \u0437\u0430\u043a\u0443\u043f\u0430\u044e\u0442 \u0442\u0430\u043c \u0442\u0438\u043f\u044b, \u0434\u0430\u0436\u0435 \u043d\u0435 \u0442\u043e \u0447\u0442\u043e\u0431\u044b \u0447\u0435\u043c\u043e\u0434\u0430\u043d\u0430\u043c\u0438, \u0430 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u044b\u043c\u0438 \u041a\u0430\u043c\u0410\u0417\u0430\u043c\u0438, \u044f \u0434\u0443\u043c\u0430\u044e. \u0414\u0430\u0432\u0430\u0439, \u041b\u0451\u0448\u0430.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep5.md#969", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 16:09 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=969", "citation_number": 2, "order": 9}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 16:09 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=969"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[1:01:22] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0422\u043e \u0435\u0441\u0442\u044c, \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f, \u0447\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043b \u0438\u0437 \u043c\u0443\u0441\u043e\u0440\u0430 \u043d\u0430\u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443, \u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u043d \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0443\u0436\u0435 \u043d\u0430 \u0442\u0440\u0438 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u043c\u0443\u0441\u043e\u0440\u0430, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e, \u043a\u0430\u043a \u0431\u044b, \u0438\u0437 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b \u043c\u0443\u0441\u043e\u0440\u0430 \u0438 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b \u0434\u043e\u0431\u0440\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c \u0442\u0440\u0438 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u043c\u0443\u0441\u043e\u0440\u0430, \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e. \u0414\u0430-\u0434\u0430-\u0434\u0430, \u0442\u043e\u043b\u044c\u043a\u043e \u0443 \u043d\u0430\u0441 \u0432\u0442\u043e\u0440\u0430\u044f \u0438\u0442\u0435\u0440\u0430\u0446\u0438\u044f, \u043d\u0443 \u0442\u0430\u043a \u0431\u044b\u0432\u0430\u0435\u0442, \u0434\u0430. \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c, \u043e\u043f\u044f\u0442\u044c \u0436\u0435, \u043d\u0430\u0448 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0414\u0430\u0440\u044c\u043e \u0410\u043c\u0430\u0434\u0435. \u041e\u043d \u043f\u0440\u044f\u043c\u043e, \u0447\u0435\u0441\u0442\u043d\u043e, \u043c\u043d\u0435 \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u044d\u0442\u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d \u043d\u0435 \u0441\u0442\u0435\u0441\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u043e \u0441\u0436\u0435\u0447\u044c \u043d\u0430\u043f\u0430\u043b\u043e\u043c \u0441\u0435\u0440\u0434\u0446\u0430 \u043b\u044e\u0434\u0435\u0439. \u041e\u043d \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u0435\u043d \u0432 \u044d\u0442\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435, \u0434\u0430\u0451\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c. \u0422\u0430\u043a \u0432\u043e\u0442, \u043e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u043e\u0434\u0430\u0436\u0430 \u041a\u0438\u0442\u0430\u044e <mark>H200</mark> \u2014 \u044d\u0442\u043e \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e, \u0447\u0442\u043e \u043f\u0440\u043e\u0434\u0430\u0436\u0430 \u044f\u0434\u0435\u0440\u043d\u043e\u0433\u043e \u043e\u0440\u0443\u0436\u0438\u044f \u0421\u0435\u0432\u0435\u0440\u043d\u043e\u0439 \u041a\u043e\u0440\u0435\u0438. \u041c\u043d\u0435, \u0447\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u0434\u0430\u0436\u0435 \u0432 \u0433\u043e\u043b\u043e\u0432\u0443 \u043d\u0435 \u043e\u0441\u043e\u0431\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442, \u043a\u0430\u043a \u043a\u043e\u043c\u0443 \u0432 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u043a\u0430\u043a \u0432 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u0421\u0435\u0432\u0435\u0440\u043d\u043e\u0439 \u041a\u043e\u0440\u0435\u0435 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u044f\u0434\u0435\u0440\u043d\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435, \u0435\u0441\u043b\u0438 \u043e\u043d\u043e \u0443 \u043d\u0435\u0451 \u0435\u0441\u0442\u044c. \u0412\u043e\u0442 \u0437\u0430\u0447\u0435\u043c? \u041f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u043a \u0431\u044b, \u043d\u0443 \u0432 \u0447\u0451\u043c \u0441\u043c\u044b\u0441\u043b? \u0414\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u043e\u043d \u043b\u0438\u0431\u043e \u0414\u0430\u0440\u044c\u044e \u0410\u043c\u0430\u0434\u0435\u044e, \u0432 \u0441\u043c\u044b\u0441\u043b\u0435 \u043e\u043d \u0447\u0442\u043e-\u0442\u043e \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0438\u0440\u0443\u0435\u0442, \u043d\u043e \u043f\u0440\u043e\u0434\u0430\u0436\u0430 <mark>H200</mark>, \u0442\u043e\u0447\u043d\u0435\u0435, \u043d\u0435 \u043f\u0440\u043e\u0434\u0430\u0436\u0430 <mark>H200</mark>, \u043a\u0430\u043a \u0441\u0435\u0439\u0447\u0430\u0441 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442, \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u044f\u0434\u0435\u0440\u043d\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435, \u0442\u043e \u0431\u0438\u0448\u044c, \u0441\u0432\u043e\u0438 \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u0435\u043b\u0438 \u0443 \u041a\u0438\u0442\u0430\u044f \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c. \u041d\u0443, \u043a\u0430\u043a \u0431\u044b. \u041c\u044b \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u0442\u043e\u0439 \u0442\u043e\u0447\u043a\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0447\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u043a\u0441\u0442\u0430\u0442\u0438, \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0432\u043e\u0442 \u043d\u0430 \u044d\u0442\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u0431\u044b\u043b\u0430 \u0435\u0449\u0451 \u043e\u0434\u043d\u0430 \u043d\u043e\u0432\u043e\u0441\u0442\u044c, \u0442\u043e\u0436\u0435 \u0443 \u043d\u0430\u0441 \u0432 \u043a\u0430\u043d\u0430\u043b\u0435 \u043c\u0435\u043b\u044c\u043a\u0430\u043b\u0430. \u0427\u0442\u043e \u0443\u0436\u0435 \u0442\u0440\u0435\u0442\u044c\u044f <mark>\u043c\u043e\u0434\u0435\u043b\u044c</mark> \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e <mark>\u043e\u0431\u0443\u0447\u0435\u043d\u0430</mark> \u043d\u0430 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0430\u0445 Ascend \u043e\u0442 Huawei. \u0422\u043e \u0435\u0441\u0442\u044c \u0441\u0435\u0439\u0447\u0430\u0441 Huawei \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e, \u043c\u043e\u0436\u043d\u043e \u0432\u043e\u0442, \u043c\u043e\u0436\u0435\u0442\u0435, \u043a\u0430\u043a \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0441\u044f, \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0442\u0432\u0438\u0442, Huawei \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f Chinese <mark>NVIDIA</mark> \u0443\u0436\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u043d\u0435 \u0437\u0430\u0432\u0442\u0440\u0430, \u0432\u043e\u0442 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043e\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f Chinese <mark>NVIDIA</mark>. \u0418 \u0438\u0437 \u044d\u0442\u043e\u0433\u043e \u043c\u044b, \u0432 \u043e\u0431\u0449\u0435\u043c-\u0442\u043e, \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c, \u0447\u0442\u043e \u0443 \u043d\u0430\u0441 \u0443\u0436\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0434\u0432\u0430 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0435\u043a\u0430. \u041f\u0440\u043e\u0441\u0442\u043e \u043c\u044b \u0435\u0449\u0451 \u044d\u0442\u043e \u043d\u0435 \u043e\u0441\u043e\u0437\u043d\u0430\u043b\u0438. \u0422\u0430\u043a \u0447\u0442\u043e \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u043a\u0430\u043a \u0431\u044b, \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0414\u0430\u0440\u044c\u043e, \u043e\u043d\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u0441\u0442\u0430\u0440\u0435\u043b\u043e, \u0447\u0442\u043e \u043b\u0438.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season2/ep3.md#3682", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-3: \u043d\u0435\u0439\u0440\u043e\u0448\u043b\u0430\u043a \u043e\u0442 \u0421\u0443\u0446\u043a\u0435\u0432\u0435\u0440\u0430 \u00b7 Google \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u0443\u0436\u0435\u043d \u00b7 \u0443\u043d\u0438\u0442\u0430\u0437\u044b \u0438 \u0418\u0418 \u00b7 1:01:22 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-3.mp3#t=3682", "citation_number": 3, "order": 37}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-3: \u043d\u0435\u0439\u0440\u043e\u0448\u043b\u0430\u043a \u043e\u0442 \u0421\u0443\u0446\u043a\u0435\u0432\u0435\u0440\u0430 \u00b7 Google \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u0443\u0436\u0435\u043d \u00b7 \u0443\u043d\u0438\u0442\u0430\u0437\u044b \u0438 \u0418\u0418 \u00b7 1:01:22 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-3.mp3#t=3682"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[30:53] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u042f \u0431\u044b, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0431\u044b\u043b \u0440\u0430\u0434, \u0435\u0441\u043b\u0438 \u0442\u044b \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043f\u0440\u0430\u0432, \u0447\u0442\u043e \u044d\u0442\u043e \u0432\u0441\u0451 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u043a\u043e\u043c\u043f\u0438\u043b\u0438\u0440\u0443\u0435\u043c\u043e, \u043d\u043e \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043b\u044e\u0431\u043e\u0439 \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u044f\u0437\u044b\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u044b \u044d\u0442\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u043c, \u043e\u043d \u043f\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e \u0431\u0443\u0434\u0435\u0442 \u043d\u0435\u043f\u043e\u043b\u043e\u043d, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e, \u043d\u0443, \u043a\u0430\u043a \u0431\u044b, \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u043e\u0432\u0430\u044f \u0438\u0434\u0435\u044f, \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u043a\u0430\u043a \u0435\u0433\u043e \u0444\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c. \u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u043c. \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0448\u0438\u0440\u043e\u043a\u043e \u043f\u0440\u043e\u0437\u0432\u0443\u0447\u0430\u043b\u0430, \u043f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435, \u0432 \u0420\u043e\u0441\u0441\u0438\u0438. \u0414\u0443\u043c\u0430\u044e, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0420\u043e\u0441\u0441\u0438\u0438. <mark>NVIDIA</mark> \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c \u043d\u0435\u043a\u0438\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u0433\u0434\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0435\u0451 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u044b</mark>. \u0422\u043e \u0435\u0441\u0442\u044c, \u0442\u0430\u043c \u0431\u0443\u0434\u0435\u0442, \u043a\u0430\u043a \u044f \u043f\u043e\u043d\u044f\u043b \u0438\u0437 \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u044f, \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0439. \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u044b\u0439 \u043c\u043e\u0434\u0443\u043b\u044c, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u0434\u0430\u0436\u0435 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043d\u044b\u0439, \u043d\u043e \u0440\u0435\u0447\u044c \u0438\u0434\u0435\u0442 \u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437 \u0432 \u043a\u0430\u043a\u043e\u0435-\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u0441\u044b\u043b\u0430\u0442\u044c IP request, \u0434\u0430, \u043d\u0443, \u0437\u0430\u043f\u0440\u043e\u0441 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u043f\u043e \u0441\u0435\u0442\u0438. \u041d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435 <mark>NVIDIA</mark> \u0438 \u043f\u043e, \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043f\u043e \u0442\u0440\u043e\u0435 \u0441\u0443\u0442\u043e\u043a, \u044f \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u044e, \u0438 \u043f\u043e \u0434\u043b\u0438\u043d\u0435 \u043e\u0442\u0432\u0435\u0442\u0430, \u0434\u0430, \u043f\u043e ping, \u0431\u0443\u0434\u0443\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430. \u041d\u0443, \u043b\u0438\u0447\u043d\u043e \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u0432 \u044d\u0442\u043e\u043c \u043d\u0438\u0447\u0435\u0433\u043e \u0442\u0430\u043a\u043e\u0433\u043e \u043d\u0435\u0442, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435, \u0430 <mark>NVIDIA</mark> \u0441\u0435\u0439\u0447\u0430\u0441 \u0442\u043e\u0440\u0433\u0443\u0435\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u043c \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c, \u043a\u043e\u0433\u0434\u0430 \u043c\u044b \u043f\u0440\u043e \u0446\u043e\u0434\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c, \u0443\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0438\u043c\u0435\u0435\u0442 \u0442\u0430\u043a\u0438\u0435 \u0448\u0442\u0443\u043a\u0438. \u0422\u043e \u0435\u0441\u0442\u044c \u044d\u0442\u043e, \u0435\u0441\u043b\u0438 \u043a\u0442\u043e-\u0442\u043e \u043f\u043e\u043c\u043d\u0438\u0442, \u0441\u043a\u0430\u043d\u0434\u0430\u043b \u0441 \u0442\u0443\u0440\u0431\u0438\u043d\u0430\u043c\u0438 \u0434\u043b\u044f \u043a\u0440\u044b\u043c\u0441\u043a\u0438\u0445 \u0422\u042d\u0426, \u043e\u0442 Siemens. \u041d\u0443, \u0442\u0430\u043c \u0438\u0445 \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u043b\u0438 \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e, \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0432, \u043e\u043f\u044f\u0442\u044c \u0436\u0435, \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u0442\u043e\u044f\u0442 \u043d\u0435 \u0442\u0430\u043c, \u0433\u0434\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u043b\u0438 \u0431\u044b \u0441\u0442\u043e\u044f\u0442\u044c \u043f\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0443. \u0418 \u044d\u0442\u043e, \u0432 \u043e\u0431\u0449\u0435\u043c, \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0435 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e. \u042d\u0442\u043e, \u0432 \u043e\u0431\u0449\u0435\u043c, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044e \u0432\u043f\u043e\u043b\u043d\u0435 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043d\u044f\u0442\u044c. \u0414\u0440\u0443\u0433\u043e\u0439 \u0432\u043e\u043f\u0440\u043e\u0441, \u0447\u0442\u043e \u044f \u0443\u0434\u0438\u0432\u043b\u0451\u043d, \u0447\u0442\u043e \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043d\u0430\u0447\u0430\u043b\u0438 \u0434\u0435\u043b\u0430\u0442\u044c. \u0412\u0438\u0434\u0438\u043c\u043e, \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u043b\u0438\u0441\u044c, \u0438\u043b\u0438 \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u0434\u0440\u0443\u0433\u0438\u0435 \u0431\u044b\u043b\u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep24.md#1853", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u211624: Optimus \u0443\u043f\u0430\u043b \u00b7 \u041a\u0438\u0442\u0430\u0439\u0446\u044b \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043b\u0438 NeurIPS \u00b7 \u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043e\u0442 \u042f\u043d\u0434\u0435\u043a\u0441\u0430 \u00b7 30:53 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge24.mp3#t=1853", "citation_number": 4, "order": 19}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u211624: Optimus \u0443\u043f\u0430\u043b \u00b7 \u041a\u0438\u0442\u0430\u0439\u0446\u044b \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043b\u0438 NeurIPS \u00b7 \u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043e\u0442 \u042f\u043d\u0434\u0435\u043a\u0441\u0430 \u00b7 30:53 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge24.mp3#t=1853"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[26:42] [\u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d] \u0414\u0430\u043b\u0435\u0435. \u042f \u0445\u043e\u0442\u0435\u043b \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u043f\u0440\u043e \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435 \u043f\u0440\u043e\u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u0447\u0442\u043e \u043c\u044b \u044d\u0442\u043e \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u043c \u0438 \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043d\u0430 \u0442\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043e\u0436\u0438\u0434\u0430\u044e\u0442 \u0441\u0442\u043e\u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0451 \u0431\u044b\u043b\u043e \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e, \u043d\u0443 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0443, \u043d\u043e \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e \u0447\u0442\u043e-\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u0441\u0434\u0435\u043b\u0430\u043d\u043e. \u041e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0437\u043d\u0430\u0442\u044c, \u043a\u0430\u043a\u0438\u0435 \u0443\u0441\u043b\u043e\u0432\u043d\u043e-\u043e\u043a\u043e\u043b\u043e\u0433\u0435\u0439\u043c\u0435\u0440\u044b, \u043d\u0435 \u0437\u043d\u0430\u044e, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u0434\u0430\u0436\u0435 \u0441\u0443\u043f\u0435\u0440 \u0442\u0443\u043f\u043e \u0441 \u043a\u0430\u043a\u0438\u0445 \u0430\u0439\u043f\u0438\u0448\u043d\u0438\u043a\u043e\u0432 \u043a\u0430\u0447\u0430\u043b\u0438 \u0441\u0432\u0435\u0436\u0438\u0435 \u0434\u0440\u0430\u0439\u0432\u0435\u0440\u0430. \u0412\u043e\u0442, \u043d\u043e \u0442\u0435, \u043a\u0442\u043e \u0437\u0430\u0445\u043e\u0442\u044f\u0442 \u0441\u043f\u0440\u044f\u0442\u0430\u0442\u044c, \u043d\u0443 \u043d\u0435 \u0437\u043d\u0430\u044e, \u0431\u0443\u0434\u0435\u0442 \u043b\u0438 <mark>NVIDIA</mark> \u0447\u0442\u043e-\u0442\u043e \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u0442\u044c. \u041d\u0443 \u0432\u043e\u0442, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, <mark>NVIDIA</mark>-\u0432\u0441\u043a\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 \u0441 QD.</p>\n<p>[\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] Invidio \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440, \u0442\u044b \u0438\u043c\u0435\u0435\u0448\u044c \u0432 \u0432\u0438\u0434\u0443, \u0447\u0442\u043e \u043c\u044b \u0441 Docker Hub \u0441\u043a\u0430\u0447\u0430\u043b\u0438 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u044b, \u0438 \u0432 \u043d\u0435\u043c \u0443\u0436\u0435 \u0437\u0430\u043b\u043e\u0436\u0435\u043d\u0430 \u041f\u041e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u0434\u0441\u044b\u043b\u0430\u0435\u0442 \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u044b. \u041d\u0443, \u044d\u0442\u043e \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u043d\u0443, \u043a\u0430\u043a \u0431\u044b, \u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u043d\u043e, \u044d\u0442\u043e \u043e\u0447\u0435\u043d\u044c \u043f\u0440\u043e\u0441\u0442\u043e.</p>\n<p>[\u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d] \u0418 \u043f\u043e\u0434\u0438 \u0441\u043b\u043e\u043c\u0430\u0439 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440, \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0435\u043c\u0443 \u043d\u0435 \u0434\u0430\u043b\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0432 Net.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u041b\u0435\u0448, \u043d\u043e \u0442\u0443\u0442 \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0432\u043f\u043e\u043b\u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0442\u0430\u043a, \u043a\u0430\u043a, \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c, \u0432 \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f \u0431\u044b\u043b\u0438 \u0441\u0435\u0440\u0432\u0435\u0440\u0430 Superdome, \u0435\u0441\u043b\u0438 \u043f\u043e\u043c\u043d\u0438\u0448\u044c. \u0422\u043e \u0435\u0441\u0442\u044c \u0442\u044b \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u043b \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0443 \u043d\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u043e\u0432.</p>\n<p>[\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0423\u0433\u0443, \u0442\u0430\u043a\u0438\u0435 \u0431\u044b\u043b\u0438, \u0434\u0430.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u0422\u043e \u0435\u0441\u0442\u044c \u0442\u0430\u043c \u0443 \u0442\u0435\u0431\u044f \u0441\u0442\u043e\u044f\u043b\u043e, \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c, \u0448\u0435\u0441\u0442\u043d\u0430\u0434\u0446\u0430\u0442\u044c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u043e\u0432, \u0434\u0430, \u0430 \u0442\u0435\u0431\u0435 \u0438\u0437 \u043a\u043e\u0440\u043e\u0431\u043a\u0438 \u0431\u044b\u043b \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u043e\u0434\u0438\u043d. \u0418 \u0442\u044b \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u043b \u0438\u0445 \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e, \u0432\u043a\u043b\u044e\u0447\u0430\u043b\u0438 \u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u043b\u0438. \u042d\u0442\u0430 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u0431\u044b\u043b\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c \u043b\u0435\u0442 \u043d\u0430\u0437\u0430\u0434. \u0412\u043e\u0442, \u0435\u0441\u043b\u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u043a\u0430\u0440\u0442\u044b <mark>H200</mark> \u043d\u0430\u0447\u043d\u0443\u0442 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438, \u0437\u043d\u0430\u0435\u0442\u0435, \u0440\u0435\u0431\u044f\u0442\u0430. \u0412\u043e\u0442 \u043e\u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437 \u0445\u043e\u0434\u0438\u0442\u044c \u043a \u043d\u0430\u043c \u0437\u0430 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0435\u0439 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e. \u0415\u0441\u043b\u0438 \u043e\u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e \u0431\u0435\u0437 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0438 \u043e\u0442\u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430, \u043e\u043d\u0430 \u0432\u044b\u0440\u0443\u0431\u0438\u0442\u0441\u044f, \u0432\u0441\u0435 \u043e\u0442\u043a\u0440\u043e\u044e\u0442 \u0442\u0430\u043c \u0434\u043e\u0441\u0442\u0443\u043f \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442. \u0422\u0435\u043c \u0431\u043e\u043b\u0435\u0435, \u0447\u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0432 \u0434\u0430\u0442\u0430-\u0446\u0435\u043d\u0442\u0440\u0430\u0445 \u043e\u043d\u0438 \u0432\u043e\u0442 \u044d\u0442\u0438 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u0430\u0440\u0442\u044b, \u043e\u043d\u0438 \u0436\u0435 \u0442\u0430\u043a \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442. \u0422\u043e \u0435\u0441\u0442\u044c, \u0442\u044b \u0441\u0442\u0430\u0432\u0438\u0448\u044c \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0439-\u0441\u0435\u0440\u0432\u0435\u0440, \u0442\u044b \u043f\u043e\u043a\u0443\u043f\u0430\u0435\u0448\u044c \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0438, \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0448\u044c \u0435\u0433\u043e \u043d\u0430 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0439-\u0441\u0435\u0440\u0432\u0435\u0440, \u0438 \u0432\u043e\u0442 \u044d\u0442\u0438 \u0432\u043e\u0442 \u043a\u0430\u0440\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 eGPU, \u043e\u043d\u0438 \u0442\u0443\u0434\u0430 \u0445\u043e\u0434\u044f\u0442. \u0422\u043e \u0435\u0441\u0442\u044c, \u043d\u0443 \u043a\u0430\u043a \u0431\u044b, \u0432\u0441\u0451 \u044d\u0442\u043e \u0432\u043e\u0442 \u0437\u0430 \u043f\u043e\u0440\u043e\u0433\u043e\u043c \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep5.md#1602", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 26:42 \u00b7 \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d, \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1602", "citation_number": 5, "order": 14}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 26:42 \u00b7 \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d, \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1602"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[34:02] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0412\u0441\u0435 \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u044e\u0442, \u0438 \u0435\u0441\u0442\u044c \u0434\u0430\u0436\u0435 \u0443\u0436\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043d\u044b \u043c\u0435\u0442\u043e\u0434\u044b \u0431\u043e\u0440\u044c\u0431\u044b \u0441 \u0442\u0430\u043a\u0438\u043c\u0438 \u0432\u0435\u0449\u0430\u043c\u0438, \u043d\u043e \u0441\u0430\u043c\u043e \u0441\u043e\u0431\u043e\u0439 \u0432\u043e\u043f\u0440\u043e\u0441\u0438\u043a\u0438. \u0422\u043e \u0435\u0441\u0442\u044c, \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u0441\u0430\u043c \u0444\u0430\u043a\u0442, \u0447\u0442\u043e \u0432\u043e\u0442 \u044d\u0442\u043e \u0432\u043e\u0442. \u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u0441\u043f\u043b\u044b\u043b\u043e, \u043e\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u043c \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u044f \u0431\u043e\u0440\u044c\u0431\u044b \u0437\u0430 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u043b\u043b\u0435\u043a\u0442. \u041f\u043e-\u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u043d\u0435 \u0441\u043a\u0430\u0436\u0435\u0448\u044c. \u041d\u0443, \u043a\u0430\u043a \u0431\u044b, \u044f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u044d\u0442\u043e \u043d\u0435 \u043a\u043e\u0441\u043d\u0451\u0442\u0441\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442</mark> \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0438\u043a\u043e\u043c\u0443 \u043e\u0441\u043e\u0431\u043e \u043d\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b. \u0410 \u0432\u043e\u0442 \u0418\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u0438 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u044b</mark> \u0434\u043b\u044f \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0432, \u0434\u0430, \u0431\u0443\u0434\u0443\u0442, \u0432\u0438\u0434\u0438\u043c\u043e, \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c, \u0438 \u0438\u0445 \u0431\u0443\u0434\u0435\u0442 \u0441\u043b\u043e\u0436\u043d\u0435\u0435 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c \u043d\u0435 \u0432 \u0442\u043e\u043c \u043c\u0435\u0441\u0442\u0435, \u0433\u0434\u0435 \u043e\u043d\u0438 \u043a\u0443\u043f\u043b\u0435\u043d\u044b. \u041d\u0443, \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443, \u0437\u0430\u043b\u043e\u0437\u0438\u0442\u044c, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432 \u0420\u043e\u0441\u0441\u0438\u044e \u0441\u0435\u0439\u0447\u0430\u0441, \u043d\u0443 \u0438\u043b\u0438 \u0432 \u041a\u0438\u0442\u0430\u0439 \u043f\u043e\u0442\u043e\u043c. \u041a\u0441\u0442\u0430\u0442\u0438, \u044f \u043d\u0435 \u0441\u0442\u0430\u043b \u044d\u0442\u0443 \u043d\u043e\u0432\u043e\u0441\u0442\u044c \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u044c, \u0445\u043e\u0442\u044f \u043e\u043d\u0430 \u0442\u0443\u0442 \u0442\u043e\u0436\u0435 \u043d\u0435\u0434\u0430\u0432\u043d\u043e \u0431\u044b\u043b\u0430, \u041a\u0438\u0442\u0430\u0439. \u0412\u0440\u043e\u0434\u0435 \u043a\u0430\u043a \u0442\u0435\u043f\u0435\u0440\u044c \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0432\u044b\u0434\u0430\u043b \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044e \u0441\u0432\u043e\u0438\u043c \u0433\u043e\u0441\u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f\u043c \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u0438\u0435 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u044b</mark>. \u0414\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u0447\u0442\u043e \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\u043c \u0442\u0430\u043c \u0437\u0430\u043f\u0440\u0435\u0442\u0430 \u043d\u0435\u0442, \u0430 \u0432\u043e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u0438\u0435 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u044b</mark> \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0435\u043c \u0432\u043b\u0430\u0434\u0435\u0435\u0442 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043e, \u043d\u0443, \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043a\u0430\u043a \u0443 \u043d\u0430\u0441 \u0434\u0435\u043b\u0430\u044e\u0442, \u043e\u043d\u0438 \u0443\u0436\u0435 \u0432\u044b\u043f\u0443\u0441\u0442\u0438\u043b\u0438 \u0442\u0430\u043a\u043e\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435. \u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u043c, \u0447\u0442\u043e \u0431\u0443\u0434\u0435\u0442.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep24.md#2042", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u211624: Optimus \u0443\u043f\u0430\u043b \u00b7 \u041a\u0438\u0442\u0430\u0439\u0446\u044b \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043b\u0438 NeurIPS \u00b7 \u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043e\u0442 \u042f\u043d\u0434\u0435\u043a\u0441\u0430 \u00b7 34:02 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge24.mp3#t=2042", "citation_number": 6, "order": 21}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u211624: Optimus \u0443\u043f\u0430\u043b \u00b7 \u041a\u0438\u0442\u0430\u0439\u0446\u044b \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043b\u0438 NeurIPS \u00b7 \u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043e\u0442 \u042f\u043d\u0434\u0435\u043a\u0441\u0430 \u00b7 34:02 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge24.mp3#t=2042"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[26:13] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0414\u043e\u043b\u0436\u043d\u043e\u0435 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0446\u0430\u043c, \u0443 \u043d\u0438\u0445 \u0438\u043c\u043f\u043e\u0440\u0442\u043e\u0437\u0430\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0438\u0434\u0451\u0442 \u0442\u043e\u0436\u0435 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0431\u043e\u0434\u0440\u043e. \u042f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0434\u0430\u0436\u0435 \u043f\u043e\u0431\u043e\u0434\u0440\u0435\u0435, \u0447\u0435\u043c \u0443 \u043d\u0430\u0441. \u0422\u0430\u043a, \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c. \u0423 \u043d\u0430\u0441, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0442\u0440\u0443\u0431\u0430 \u043f\u043e\u043d\u0438\u0436\u0435\u043d\u0430 \u0438\u043c\u043f\u0430\u0436\u0430 \u0416\u0416, \u043d\u043e \u0442\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0442\u043e\u0436\u0435 \u043a\u0430\u043a\u0430\u044f-\u0442\u043e \u0447\u0442\u043e-\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0435. \u0415\u0441\u0442\u044c \u0442\u0430\u043a\u0430\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f, \u043e\u0431\u043b\u0430\u0447\u043d\u044b\u0439 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440, <mark>Selectel</mark>, \u044f \u0434\u0443\u043c\u0430\u044e, \u043d\u0430 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u043c \u0440\u044b\u043d\u043a\u0435 \u0441 \u043d\u0435\u0439 \u0432\u0441\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u044b. \u0418\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u0431\u0435\u0437 \u0432\u0441\u0435\u0433\u043e. \u0422\u043e \u0435\u0441\u0442\u044c, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0442\u044c \u0441 \u042f\u043d\u0434\u0435\u043a\u0441\u043e\u043c \u043d\u0435 \u0441\u043e\u0432\u0441\u0435\u043c \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u042f\u043d\u0434\u0435\u043a\u0441 \u2014 \u044d\u0442\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439, \u0442\u043e \u0435\u0441\u0442\u044c \u043e\u043d \u0441\u0430\u043c \u043f\u043e \u0441\u0435\u0431\u0435 \u0432\u0435\u043d\u0434\u043e\u0440. \u0410 <mark>Selectel</mark> \u2014 \u044d\u0442\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a \u043e\u0431\u043b\u0430\u0447\u043d\u044b\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u0439. \u0418 \u044f \u043d\u0435 \u043f\u043e\u043c\u043d\u044e, \u0437\u0434\u0435\u0441\u044c \u044d\u0442\u043e \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0438\u043b\u0438 \u043d\u0435\u0442. \u0414\u0430, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u0432 \u044d\u0442\u043e\u0439 \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u043d\u0435\u0442, \u043d\u043e \u0431\u044b\u043b\u0430 \u0432\u0442\u043e\u0440\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c \u043f\u0440\u043e <mark>Selectel</mark> \u0438\u043b\u0438 \u0442\u0430 \u0436\u0435 \u0441\u0430\u043c\u0430\u044f, \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0434\u0440\u0443\u0433\u043e\u043c \u0438\u0437\u0434\u0430\u043d\u0438\u0438, \u0433\u0434\u0435 \u043e\u043d\u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u0441\u0442\u0430\u0442\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a\u043e\u043c. \u0416\u0435\u043b\u0435\u0437\u043e <mark>H200</mark>, \u0442\u043e \u0435\u0441\u0442\u044c \u0432\u043e\u0442 \u044d\u0442\u0438\u0445 \u0432\u043e\u0442 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 <mark>NVIDIA</mark> \u043a\u0430\u0440\u0442\u043e\u0447\u0435\u043a \u043d\u0430 \u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u043c \u0440\u044b\u043d\u043a\u0435 \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u043e\u0431\u043b\u0430\u043a\u0435. \u0414\u0430\u0436\u0435 \u043a\u043e \u043c\u043d\u0435 \u0443\u0436\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u0438 \u043b\u044e\u0434\u0438 \u0438 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b\u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0443 \u043d\u0438\u0445 \u0437\u0430\u043a\u0443\u043f\u0438\u0442\u044c. \u042f \u0438\u043c\u0435\u044e \u0432 \u0432\u0438\u0434\u0443, \u043b\u044e\u0434\u0438 \u0438\u0437 <mark>Selectel</mark> \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b\u0438 \u0443 \u043d\u0438\u0445 \u0437\u0430\u043a\u0443\u043f\u0438\u0442\u044c \u044d\u0442\u0438 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438. \u0427\u0442\u043e, \u0432 \u043e\u0431\u0449\u0435\u043c, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u0445\u043e\u0440\u043e\u0448\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442, \u0435\u0441\u043b\u0438 \u0447\u0442\u043e, \u0433\u0434\u0435-\u0442\u043e \u0432\u0437\u044f\u0442\u044c \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0432\u043e\u043f\u0440\u043e\u0441, \u0433\u0434\u0435 \u043e\u043d\u0438 \u0441\u0430\u043c\u0438 \u0438\u0445 \u0432\u0437\u044f\u043b\u0438, \u043d\u043e \u044f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u044d\u0442\u043e \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0430\u0439\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0438\u043a\u0442\u043e \u043e\u0441\u043e\u0431\u043e \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043d\u0435 \u0445\u043e\u0447\u0435\u0442. \u0412\u0437\u044f\u043b\u0438 \u0438 \u0432\u0437\u044f\u043b\u0438. \u0421\u043b\u0430\u0432\u0430 \u0431\u043e\u0433\u0443, \u0447\u0442\u043e \u0442\u0430\u043a\u0430\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u0421\u043b\u0443\u0448\u0430\u0439, \u043d\u0443, \u0441\u0435\u043b\u0435\u043a\u0442\u043e\u0440\u044b, \u0432\u043e\u043e\u0431\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f, \u043c\u043e\u043b\u043e\u0434\u0446\u044b. \u0422\u043e \u0435\u0441\u0442\u044c \u043e\u043d\u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0443, \u0431\u0443\u0434\u0443\u0447\u0438, \u043a\u0430\u043a \u0442\u044b \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u0437\u0430\u043c\u0435\u0442\u0438\u043b. \u0418\u043c\u0435\u043d\u043d\u043e \u0432 AI \u043a\u043b\u0430\u0441\u0441\u043e\u0432 \u0441\u0438\u043b\u044c\u043d\u043e \u043d\u0438\u0436\u0435, \u0442\u043e \u0435\u0441\u0442\u044c \u0441\u043e\u0432\u0441\u0435\u043c \u0434\u0440\u0443\u0433\u0430\u044f \u043b\u0438\u0433\u0430, \u0447\u0435\u043c \u0442\u043e\u0442 \u0436\u0435 \u0441\u0430\u043c\u044b\u0439 \u0421\u0431\u0435\u0440 \u0438\u043b\u0438 \u042f\u043d\u0434\u0435\u043a\u0441. \u0412\u043e\u0442, \u0442\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u043e\u043d\u0438 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0438 Foundation Model Catalog. \u0412\u043e\u0442 \u043e\u043d\u0438 \u043a\u0430\u043a \u0440\u0430\u0437 \u0414\u0435\u043b\u0430\u044e\u0442 \u043c\u043d\u043e\u0433\u043e \u0447\u0435\u0433\u043e \u0434\u043b\u044f AI. \u041e\u043d\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u0442\u043e \u0435\u0441\u0442\u044c \u043e\u043d\u0438 \u043f\u0438\u0448\u0443\u0442 \u0441\u0442\u0430\u0442\u044c\u0438, \u043a\u0430\u043a \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u044e\u0442, \u043f\u0438\u0448\u0443\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435. \u0422\u043e \u0435\u0441\u0442\u044c \u043e\u043d\u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0442 \u0440\u044b\u043d\u043e\u043a, \u0447\u0435\u0441\u0442\u043d\u043e. \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0432\u0438\u0433\u0430\u044e\u0442 \u043a\u043e\u0440\u043e\u0431\u043a\u0438, \u0430 \u043e\u043d\u0438 \u043f\u0440\u0438\u043d\u043e\u0441\u044f\u0442 \u043d\u0430 \u0440\u044b\u043d\u043e\u043a \u043a\u043e\u0440\u043e\u0431\u043a\u0438, \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044e\u0442, \u043a\u0430\u043a\u0438\u043c\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f, \u0441\u0442\u0440\u043e\u044f\u0442 \u043a\u0430\u043a\u0443\u044e-\u0442\u043e \u044d\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0443, \u0442\u043e \u0435\u0441\u0442\u044c \u043e\u043d\u0438 \u043f\u0440\u044f\u043c \u044d\u043c\u043e\u0446\u0438\u0438.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep15.md#1573", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u211615: Intel \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439 \u0447\u0438\u043f \u00b7 nVIDIA, OpenAI \u0438 \u0432\u0441\u0435-\u0432\u0441\u0435-\u0432\u0441\u0435 \u00b7 \u043f\u043e\u0436\u0430\u0440 \u0432 \u0426\u041e\u0414 \u00b7 26:13 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge15.mp3#t=1573", "citation_number": 7, "order": 17}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u211615: Intel \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0439 \u0447\u0438\u043f \u00b7 nVIDIA, OpenAI \u0438 \u0432\u0441\u0435-\u0432\u0441\u0435-\u0432\u0441\u0435 \u00b7 \u043f\u043e\u0436\u0430\u0440 \u0432 \u0426\u041e\u0414 \u00b7 26:13 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge15.mp3#t=1573"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[17:47] [\u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d] \u041d\u0443, \u044f \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0435\u0441\u0442\u044c \u0442\u0430\u043a\u043e\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435, \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0442\u043e, \u0447\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0433\u043e \u0440\u043e\u0434\u0430 \u0447\u0438\u043f\u044b \u043f\u043e\u043a\u0443\u043f\u0430\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0443\u043f\u043d\u044b\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u044b, \u043d\u0443 \u0442\u043e \u0435\u0441\u0442\u044c \u043d\u0435 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0440\u043e\u0437\u043d\u0438\u0447\u043d\u044b\u0439 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c \u0438 \u043d\u0435 \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435. \u041c\u0430\u043b\u044b\u0435 \u0438 \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u044f\u0442\u0438\u044f, \u0430 \u0432\u043e\u043e\u0431\u0449\u0435, \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u043e\u0431\u043b\u0430\u043a\u0430. \u041f\u043e\u0447\u0442\u0438, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u0442\u0430\u043c \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c, \u0441\u043a\u0430\u0436\u0435\u043c \u0442\u0430\u043a, \u0430\u043d\u0430\u043b\u043e\u0433\u0438 backdoor \u0440\u0430\u0437\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0442\u0430\u043a\u043e\u0439 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0430\u043a\u0430\u043b, \u0447\u0442\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u043e\u0447\u0435\u043c\u0443 \u041a\u0438\u0442\u0430\u0439 \u043f\u0440\u043e\u0434\u0430\u044e\u0442 \u0438 \u0434\u0435\u043b\u0430\u044e\u0442 \u0442\u0430\u043a\u0443\u044e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u0443\u044e \u043b\u0438\u043d\u0435\u0439\u043a\u0443. \u041d\u0430 \u044d\u0442\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u0431\u044b\u043b\u0430 \u0435\u0449\u0451 \u043f\u043e\u0445\u043e\u0436\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c, \u043d\u0443, \u0432 \u0442\u0443 \u0436\u0435 \u0441\u0442\u0435\u0437\u044e. \u041f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e <mark>NVIDIA</mark> \u0434\u0443\u043c\u0430\u0435\u0442 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0447\u0438\u043f\u044b \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434 \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u0438\u0439 \u0440\u044b\u043d\u043e\u043a, \u0442\u043e\u0436\u0435 \u0438 \u0441\u0432\u043e\u0438\u0445 \u0438\u043c\u0435\u044e\u0449\u0438\u0445\u0441\u044f \u043b\u0438\u043d\u0435\u0435\u043a, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0442\u0430\u043c \u043d\u0435 \u0443\u0442\u0440\u044f\u0441\u043b\u0438, \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e, \u0447\u0442\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u044c. \u0418 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0441\u043c\u044b\u0441\u043b\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u0443\u0442\u044c \u0442\u0430 \u0436\u0435 \u0441\u0430\u043c\u0430\u044f. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u0442\u043e, \u0432 \u043a\u0430\u043a\u043e\u043c \u0432\u0438\u0434\u0435 \u044d\u0442\u043e. \u042d\u0442\u0438, \u043a\u0430\u043a \u0442\u0443\u0442 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043e, \u0448\u043f\u0438\u043e\u043d\u0441\u043a\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0442\u0443\u0434\u0430 \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u043b\u043e\u0436\u0435\u043d\u044b, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u0444\u0430\u043d\u0442\u0430\u0437\u0438\u044f, \u0447\u0442\u043e \u043d\u0443 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0440\u0435\u043a\u0435\u0440 \u0442\u0443\u0434\u0430 \u0444\u0438\u0433 \u043f\u043e\u043b\u043e\u0436\u0438\u0448\u044c, \u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u0442\u0430\u043c \u043f\u0440\u0438 \u043f\u043e\u043f\u044b\u0442\u043a\u0435. \u0421\u0432\u044f\u0437\u0438 \u0441 \u0441\u0435\u0442\u044c\u044e, \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u043f\u0430\u043a\u0435\u0442\u044b \u0431\u0443\u0434\u0443\u0442 \u043f\u043e\u0441\u044b\u043b\u0430\u0442\u044c\u0441\u044f. \u041c\u043e\u0436\u0435\u0442\u0435 \u043b\u0438 \u044d\u0442\u0438 \u043f\u0430\u043a\u0435\u0442\u044b \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u0442\u044c? \u041c\u043e\u0436\u0435\u0442\u0435 \u043b\u0438 \u0438\u0445, \u043d\u0435 \u0437\u043d\u0430\u044e, \u043e\u0442\u0441\u043b\u0435\u0434\u0438\u0442\u044c \u043f\u043e \u043f\u0438\u043d\u0433\u0443 \u0438\u043b\u0438 \u043a\u0430\u043a-\u0442\u043e \u043f\u0435\u0440\u0435\u043f\u0440\u044f\u0442\u0430\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0430\u043d\u0430\u043b\u043e\u0433 \u043a\u0430\u043a\u0438\u0445-\u0442\u043e Minshedlsocks \u0438 \u043f\u0440\u043e\u0447\u0435\u0433\u043e, \u0447\u0442\u043e \u0442\u0438\u043f\u0430 \u0433\u0434\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u044d\u0442\u043e\u0442 \u0447\u0438\u043f? \u041d\u0443, \u0447\u0442\u043e \u043d\u0430 \u043d\u0435\u043c \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, \u044d\u0442\u043e \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u044f\u043a, \u043d\u043e \u0433\u0434\u0435 \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f? \u0410 \u0442\u043e \u0432\u0434\u0440\u0443\u0433 \u0435\u0433\u043e \u0432 \u0441\u0430\u043c\u043e\u043b\u0435\u0442 \u043f\u043e\u0441\u0442\u0430\u0432\u044f\u0442.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep5.md#1067", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 17:47 \u00b7 \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1067", "citation_number": 9, "order": 10}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 17:47 \u00b7 \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1067"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[19:31] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0412\u043e\u0442 \u0438\u043b\u0438 \u0435\u0449\u0451 \u043a\u0443\u0434\u0430-\u043d\u0438\u0431\u0443\u0434\u044c. \u042f \u0442\u0443\u0442 \u0445\u043e\u0447\u0443 \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u0442\u044c, \u0442\u044b \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043d\u044f\u043b \u0445\u043e\u0440\u043e\u0448\u0443\u044e \u0442\u0435\u043c\u0443, \u0447\u0442\u043e \u044f \u0437\u0430\u0431\u044b\u043b, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u0436\u0435 \u043b\u0435\u0442 \u043d\u0430\u0437\u0430\u0434, \u0441\u043a\u0430\u0436\u0435\u043c, \u043b\u0435\u0442 \u0434\u0435\u0441\u044f\u0442\u044c, \u044f \u043d\u0435 \u043f\u043e\u043c\u043d\u044e \u0442\u043e\u0447\u043d\u043e, \u0432 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u0445 Intel, pardon, \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0430\u0445 Intel, \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0442\u0430\u043a\u043e\u0439 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439. \u041a\u0430\u043a \u0431\u044b \u044d\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0443\u0440 \u0432\u043d\u0443\u0442\u0440\u0438 \u0443\u0436\u0435 \u0441\u0430\u043c\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0430, \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 Ring 0, \u0442\u043e \u0435\u0441\u0442\u044c \u043d\u0443\u043b\u0435\u0432\u043e\u0435 \u043a\u043e\u043b\u044c\u0446\u043e, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u0438\u0441\u043f\u043e\u043b\u043d\u044f\u043b\u0441\u044f \u0441\u0430\u043c \u043a\u043e\u0434 \u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043b \u0432 \u0441\u0435\u0431\u0435 backdoor, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043a\u0430\u043a\u0438\u043c-\u0442\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438. \u042f \u043f\u043e\u043c\u043d\u044e, \u0447\u0442\u043e \u044d\u0442\u043e \u0431\u044b\u043b \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0441\u043a\u0430\u043d\u0434\u0430\u043b, \u0447\u0442\u043e \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438, \u0447\u0442\u043e \u0442\u0430\u043c \u0435\u0441\u0442\u044c backdoor. \u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u043b\u0438 backdoor, \u0447\u0442\u043e \u043e\u043d \u0432 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u0435\u0441\u0442\u044c. \u0412\u043e-\u0432\u0442\u043e\u0440\u044b\u0445, \u0432\u044b\u044f\u0441\u043d\u0438\u043b\u0438, \u0434\u043b\u044f \u0447\u0435\u0433\u043e \u044d\u0442\u043e\u0442 backdoor, \u0447\u0442\u043e \u043e\u043d \u0432\u0440\u043e\u0434\u0435 \u043a\u0430\u043a \u0431\u044b\u043b \u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u0434\u043b\u044f \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u0445 \u0441\u043f\u0435\u0446\u0441\u043b\u0443\u0436\u0431, \u0447\u0442\u043e \u0432 \u043e\u0431\u0449\u0435\u043c \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u043b\u043e\u0433\u0438\u0447\u043d\u043e \u0434\u043b\u044f \u043a\u043e\u0433\u043e \u0435\u0449\u0451. \u041d\u043e, \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u0441\u043a\u0430\u043d\u0434\u0430\u043b \u0431\u044b\u043b \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u044d\u0442\u043e\u0442 backdoor \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u0441\u043e\u0432\u0441\u0435\u043c backdoor, \u0447\u0442\u043e \u0443\u0436\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0430\u043c \u0443\u0436\u0435 \u043d\u0435 door, \u0430 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u044b\u0435 \u0432\u043e\u0440\u043e\u0442\u0430. \u0414\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u0443\u0436\u0435, \u0432 \u043e\u0431\u0449\u0435\u043c, \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e \u043d\u0430\u0443\u0447\u0438\u043b\u0438\u0441\u044c \u044d\u0442\u043e \u043b\u043e\u043c\u0430\u0442\u044c. \u0418 \u0441 \u0442\u0435\u0445 \u043f\u043e\u0440 \u043a\u0430\u043a-\u0442\u043e \u0432\u043e\u0442 \u044d\u0442\u0430 \u0432\u0441\u044f \u0434\u0432\u0438\u0436\u0443\u0445\u0430 \u0441\u043e\u0448\u043b\u0430 \u043d\u0430 \u043d\u0435\u0442. \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u0435\u0433\u043e \u043a\u0430\u043a-\u0442\u043e \u043f\u0440\u0438\u043f\u043e\u0434\u0437\u0430\u043a\u0440\u044b\u043b\u0438, \u043d\u043e \u044f, \u0447\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u043d\u0435 \u043f\u043e\u043c\u043d\u044e. \u0414\u0438\u043c, \u043c\u043e\u0436\u0435\u0442, \u0442\u044b \u043f\u043e\u043c\u043d\u0438\u0448\u044c?</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u042f \u043f\u043e\u043c\u043d\u044e, \u0442\u0430\u043c \u0431\u044b\u043b\u043e... \u0414\u0435\u043b\u043e \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0443 \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u044b\u0445, \u0435\u0441\u043b\u0438 \u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u043c\u043d\u044e, \u043e \u0447\u0451\u043c \u044d\u0442\u043e, \u0443 \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u0438\u0445 \u043f\u043b\u0430\u0442, \u0443 \u043d\u0438\u0445 \u0435\u0441\u0442\u044c \u0441\u043f\u043e\u0441\u043e\u0431 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f \u0443\u0434\u0430\u043b\u0451\u043d\u043d\u043e \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0438\u043c\u0438, \u0442\u043e \u0435\u0441\u0442\u044c \u0443 \u0432\u0441\u0435\u0445. \u0414\u0430, IPMI, \u0438 \u043e\u043d \u0430\u043a\u0442\u0438\u0432\u0435\u043d \u0434\u0430\u0436\u0435 \u043f\u0440\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435, \u0435\u0441\u043b\u0438 \u043d\u0430 \u043f\u0438\u0442\u0430\u043d\u0438\u0435, \u043d\u0430 \u043f\u043b\u0430\u0442\u0443 \u043f\u043e\u0434\u0430\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0443\u0434\u0430\u043b\u0435\u043d\u043d\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435. \u0418 \u0432\u043e\u0442 \u0432 \u043d\u0435\u043c backdoor \u0438 \u0431\u044b\u043b. \u0418 \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0442\u0430\u043a \u043f\u0440\u044f\u043c\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u044d\u0442\u043e \u043a\u0430\u0441\u0430\u043b\u043e\u0441\u044c \u043d\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u043d\u043e \u044d\u0442\u043e \u043a\u0430\u0441\u0430\u043b\u043e\u0441\u044c \u0432\u0441\u0435\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0432. \u041a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u043e\u0440\u0447\u0430\u043b\u0430 \u043d\u0430\u0440\u0443\u0436\u0443 \u0443 \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0432. \u0423 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0440\u0435\u0434\u043a\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u0438\u0435 \u043f\u043b\u0430\u0442\u044b \u0442\u0430\u043a\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430, \u0430 \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u0445 \u0432\u0441\u0435\u0433\u0434\u0430. \u0412\u043e\u0442, \u0430 \u043f\u043e \u0442\u0435\u043c\u0435 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f, \u0434\u0435\u043b\u043e \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u044d\u0442\u043e \u043d\u0435 \u0441\u043e\u0432\u0441\u0435\u043c, \u043a\u0430\u043a \u0431\u044b, \u0448\u043f\u0438\u043e\u043d\u0441\u043a\u0438\u0435 \u0441\u0442\u0440\u0430\u0441\u0442\u0438. \u0412 \u0430\u043f\u0440\u0435\u043b\u0435 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u044b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438 \u0410\u043d\u043e\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0437\u0430\u043a\u043e\u043d\u043e\u043f\u0440\u043e\u0435\u043a\u0442 \u0443 \u043d\u0438\u0445 \u0432 \u0428\u0442\u0430\u0442\u0430\u0445 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u0431\u044f\u0436\u0443\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c, \u0433\u0434\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u0440\u0442\u0430, \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430 \u043a\u0430\u0440\u0442, \u043d\u0430\u0447\u0438\u043d\u0430\u044f, \u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u043e\u0447\u0438\u043c, \u0441 40-\u0439 \u0441\u0435\u0440\u0438\u0438, \u0441 4090. \u0412\u043e\u0442. \u041d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 4090 \u0438 \u0432\u044b\u0448\u0435. \u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c \u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0442\u044c.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep5.md#1171", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 19:31 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1171", "citation_number": 10, "order": 11}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 19:31 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1171"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[22:04] [\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u0418 8 \u043c\u0430\u044f \u044d\u0442\u043e\u0442 \u0437\u0430\u043a\u043e\u043d\u043e\u043f\u0440\u043e\u0435\u043a\u0442 \u0431\u044b\u043b \u0432\u043d\u0435\u0441\u0435\u043d, \u0438 \u0432\u0440\u043e\u0434\u0435 \u0431\u044b \u043a\u0430\u043a \u0441\u0440\u043e\u043a \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u2014 \u0448\u0435\u0441\u0442\u044c \u043c\u0435\u0441\u044f\u0446\u0435\u0432. \u0422\u043e \u0435\u0441\u0442\u044c, \u0447\u0442\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u043c\u0435\u0440\u044b \u043d\u0443\u0436\u043d\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0448\u0435\u0441\u0442\u0438 \u043c\u0435\u0441\u044f\u0446\u0435\u0432. \u0412\u043e\u0442, \u0442\u043e \u0435\u0441\u0442\u044c \u044d\u0442\u043e. \u0422\u043e\u043c \u041a\u043e\u0442\u0442\u043e\u043d, \u0441\u0435\u043d\u0430\u0442\u043e\u0440 \u0438\u0437 \u0410\u0440\u043a\u0430\u043d\u0437\u0430\u0441\u0430, \u043e\u043d \u0435\u0433\u043e 9 \u043c\u0430\u044f \u0432\u043d\u0451\u0441. \u0418 \u0432\u043e\u0442 \u043e\u043d, \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043a\u0430\u043a \u0438 \u0447\u0442\u043e \u0441 \u043d\u0438\u043c \u0434\u0430\u043b\u044c\u0448\u0435 \u043f\u043e\u0448\u043b\u043e? \u042f \u043f\u0440\u043e\u0441\u0442\u043e \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043a\u0438\u0442\u0430\u0439\u0446\u044b \u043d\u0435 \u0432\u044b\u0434\u0443\u043c\u044b\u0432\u0430\u044e\u0442. \u041a\u0438\u0442\u0430\u0439\u0446\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0442\u0435\u043a\u0441\u0442 \u0431\u0435\u0437 \u0441\u0430\u0439\u0442\u0430 \u0411\u0435\u043b\u043e\u0433\u043e \u0434\u043e\u043c\u0430. \u0412\u043e\u0442. \u0410 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b \u0442\u0430\u043c \u0442\u0430\u043a\u0438\u0435, \u0442\u043e \u0435\u0441\u0442\u044c \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0438\u043d\u0433\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u043d\u0430 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0438\u0434\u0451\u0442 \u0434\u043e \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u041e\u0442\u043a\u043b\u044e\u0447\u0430\u0442\u044c, \u043d\u043e \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0442\u044c, \u0432\u0440\u043e\u0434\u0435 \u0431\u044b, \u043a\u0430\u043a \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043b \u043e\u0434\u0438\u043d \u0438\u0437 \u0442\u043e\u0436\u0435 \u0441\u0435\u043d\u0430\u0442\u043e\u0440\u043e\u0432, \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u044d\u0442\u043e\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0443\u0436\u0435 \u0435\u0441\u0442\u044c \u0432 <mark>NVIDIA</mark>-\u043a\u0430\u0440\u0442\u0430\u0445. \u0414\u0430\u043b\u044c\u0448\u0435 \u043d\u0430\u0434\u043e \u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u043f\u0438\u043b\u0438\u0442\u044c. \u0412\u043e\u0442, \u0442\u043e \u0435\u0441\u0442\u044c \u044d\u0442\u043e \u0432 \u0430\u043f\u0440\u0435\u043b\u0435 \u043a\u0430\u043a \u0440\u0430\u0437 \u043d\u0430 \u0441\u043b\u0443\u0448\u0430\u043d\u0438\u044f\u0445, \u043a\u043e\u0433\u0434\u0430 \u0432\u0441\u0451 \u044d\u0442\u043e \u0434\u0435\u043b\u043e \u0430\u043d\u043e\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043b\u0438, \u0411\u0438\u043b\u043b \u0424\u043e\u0440\u0435\u0441\u0442 \u0433\u043e\u0432\u043e\u0440\u0438\u043b, \u0447\u0442\u043e \u043d\u0443, \u0432 \u043e\u0431\u0449\u0435\u043c, \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0451 \u0432 <mark>NVIDIA</mark> \u0443\u0436\u0435 \u0435\u0441\u0442\u044c, \u0442\u0430\u043c \u043d\u0435\u043c\u043d\u043e\u0436\u043a\u043e \u043d\u0430\u0434\u043e \u043f\u043e\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c, \u043f\u043e\u044d\u0442\u043e\u043c\u0443.</p>\n<p>[\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u041d\u0443 \u0432\u043e\u0442 \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e, \u043d\u0443, 4090, \u043e\u043d\u0430 \u0432\u0440\u043e\u0434\u0435 \u043a\u0430\u043a \u0442\u043e, \u0447\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u043e\u043d\u0441\u044e\u043c\u0435\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0430, \u0434\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u043a\u0430\u0440\u0442\u0430 \u0434\u043b\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044f. \u041d\u0443 \u0442\u043e \u0435\u0441\u0442\u044c, \u0435\u0441\u043b\u0438 \u0431\u044b \u044f \u0437\u0430\u0445\u043e\u0442\u0435\u043b \u043f\u043e\u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0443\u044e \u0438\u0433\u0440\u0443\u0448\u043a\u0443, \u044f \u0431\u044b \u043a\u0443\u043f\u0438\u043b \u0441\u0435\u0431\u0435 \u0432\u043e\u0442 \u044d\u0442\u0443 \u043a\u0430\u043a\u0443\u044e-\u043d\u0438\u0431\u0443\u0434\u044c 4080, 4090 \u0438\u043b\u0438 \u0447\u0442\u043e-\u043d\u0438\u0431\u0443\u0434\u044c \u0442\u0430\u043a\u043e\u0435. \u0418 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u0438\u043c \u0441\u0435\u043d\u0430\u0442\u043e\u0440\u0430\u043c \u0435\u0441\u0442\u044c \u043a\u0430\u043a\u043e\u0435-\u0442\u043e \u0434\u0435\u043b\u043e, \u0434\u043e \u0447\u0435\u0433\u043e \u044f \u0442\u0430\u043c \u0438\u0433\u0440\u0430\u044e, \u043d\u0435 \u0437\u043d\u0430\u044e, \u0441\u0432\u043e\u0439 Fallout 2, \u0434\u0430, \u043d\u0430 \u044d\u0442\u043e\u0439 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u0435</mark>. \u042d\u0442\u043e \u043f\u0440\u044f\u043c\u043e \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u041d\u0443, \u0432\u043e\u043e\u0431\u0449\u0435, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c 40-90 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0445\u043e\u0440\u043e\u0448\u0430\u044f. \u0412\u043e\u0442, \u0442\u043e \u0435\u0441\u0442\u044c, \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435, \u0435\u0441\u043b\u0438 \u0431\u044b \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u044c, \u0442\u043e \u043e\u043d\u0430 \u0432\u043e\u043e\u0431\u0449\u0435-\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 100. \u0412\u043e\u0442.</p>\n<p>[\u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d] \u041a\u0438\u0442\u0430\u0439\u0441\u043a\u0430\u044f \u0412\u0410\u0413-\u041f\u043e\u0434\u0435\u043b\u0438\u044f 4090, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u0435\u0440\u0435\u043f\u0430\u044f\u043b\u0438 \u0438 \u0432 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u043f\u0430\u044f\u043b\u0438 48 \u0433\u0438\u0433\u043e\u0432. \u041d\u0435 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0447\u0442\u043e, \u043a\u0441\u0442\u0430\u0442\u0438, \u043a\u0438\u0442\u0430\u0439\u0446\u044b \u043c\u043e\u0433\u043b\u0438 \u0442\u0430\u043c \u0447\u0442\u043e-\u043d\u0438\u0431\u0443\u0434\u044c \u043b\u0438\u0448\u043d\u0435\u0435 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c \u0438 \u0433\u0440\u0430\u0445\u043d\u0443\u0442\u044c.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u0414\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443, \u043a\u0430\u043a \u0431\u044b, \u043a\u0438\u0442\u0430\u0439\u0446\u044b \u0434\u0435\u043b\u0430\u044e\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0440\u0430\u0437\u0443\u043c\u043d\u043e. \u0418 \u0442\u0443\u0442 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442, \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435, \u0435\u0441\u043b\u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0443\u0436\u0435 \u0435\u0441\u0442\u044c, \u0442\u043e \u0442\u043e, \u0447\u0442\u043e \u043a\u0430\u0440\u0442\u044b <mark>H200</mark> \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u044e\u0442, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u0443\u0440\u043e\u0432\u044b\u0439 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u043e\u043d\u0438 \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u044e\u0442 \u0442\u0443\u0434\u0430, \u043a\u0443\u0434\u0430 \u043d\u0430\u0434\u043e. \u0412 \u0442\u043e\u043c \u0441\u043c\u044b\u0441\u043b\u0435, \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u043a \u0440\u0430\u0437 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c, \u043a\u0443\u0434\u0430 \u0436\u0435 \u043e\u043d\u0438 \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u044e\u0442.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep5.md#1324", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 22:04 \u00b7 \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432, \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1324", "citation_number": 11, "order": 12}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 22:04 \u00b7 \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432, \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u041d\u0430\u0442\u0451\u043a\u0438\u043d", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1324"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[24:37] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u041d\u0443 \u0434\u0430, \u0432 \u044d\u0442\u043e\u043c \u043f\u043b\u0430\u043d\u0435, \u0434\u0430. \u0422\u043e \u0435\u0441\u0442\u044c, \u0442\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u043f\u0440\u043e IPMI, \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0431\u044b\u043b\u0430 \u044d\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0441 IPMI, \u043d\u043e IPMI \u2014 \u044d\u0442\u043e \u041d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0447\u0438\u043f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430 \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u043e\u0439 \u043f\u043b\u0430\u0442\u0435. \u042f \u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b. \u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e, backdoor \u0432 \u0441\u0430\u043c\u0438\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0430\u0445. \u0414\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u043a \u0441\u0430\u043c\u043e\u043c\u0443 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0443 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0438\u0442\u044c\u0441\u044f, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0447\u0435\u0440\u0435\u0437 IPMI, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044f \u043f\u043e\u043c\u043d\u044e. \u041d\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e. \u041f\u0440\u0438\u043d\u0446\u0438\u043f\u0438\u0430\u043b\u044c\u043d\u043e \u0431\u044b\u043b\u043e, \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0430\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440, \u0438 \u0442\u0430\u043c \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e... \u0415\u0433\u043e \u043b\u0438\u0431\u043e \u043e\u043a\u0438\u0440\u043f\u0438\u0447\u0438\u0442\u044c, \u0442\u043e \u0435\u0441\u0442\u044c \u0441\u0440\u0430\u0437\u0443 \u0443\u0431\u0438\u0442\u044c, \u043b\u0438\u0431\u043e \u0447\u0442\u043e-\u0442\u043e \u0435\u0449\u0451 \u043a\u0430\u043a-\u0442\u043e \u043d\u0435\u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u0441 \u043d\u0438\u043c \u0441\u0434\u0435\u043b\u0430\u0442\u044c. \u041d\u0443, \u0432 \u043e\u0431\u0449\u0435\u043c, \u0441\u0443\u0442\u044c \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u043e \u0432\u043d\u0443\u0442\u0440\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0430 \u0437\u0430\u0448\u0438\u0442. \u042d\u0442\u043e \u0434\u0430\u0436\u0435 \u043d\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u0430\u044f \u043f\u043b\u0430\u0442\u0430. \u042d\u0442\u043e \u0435\u0449\u0451 \u0433\u043b\u0443\u0431\u0436\u0435 \u0442\u043e, \u0447\u0442\u043e \u043f\u043e-\u0445\u043e\u0440\u043e\u0448\u0435\u043c\u0443 \u0443\u0436\u0435 \u0434\u0430\u0436\u0435 \u043f\u0430\u044f\u043b\u044c\u043d\u0438\u043a\u043e\u043c \u043d\u0435 \u0440\u0430\u0441\u043a\u043e\u0432\u044b\u0440\u044f\u0435\u0448\u044c \u043f\u0440\u0438 \u0432\u0441\u0451\u043c. \u041f\u043e \u0444\u0430\u043a\u0442\u0443, \u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043f\u0440\u043e \u043f\u0435\u0440\u0435\u043f\u0430\u043b\u044c\u043a\u0443, \u0434\u0430, \u041b\u0435\u0448\u0430 \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u043b, \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0434\u0430\u0436\u0435 \u043b\u0438\u0447\u043d\u043e \u043c\u043d\u0435 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u043b\u0438 \u0432\u0437\u044f\u0442\u044c \u0437\u0430 \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0432\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u0432\u043e\u0442 \u044d\u0442\u043e\u0442 \u0432\u043e\u0442 4090 \u0441 \u043f\u0435\u0440\u0435\u043f\u0430\u044f\u043d\u043d\u043e\u0439 \u043f\u0430\u043c\u044f\u0442\u044c\u044e, \u0447\u0442\u043e-\u0442\u043e \u0442\u0430\u043c \u0434\u0435\u043d\u0435\u0433 \u0442\u0438\u043f\u0430 200 \u0442\u044b\u0441\u044f\u0447 \u0440\u0443\u0431\u043b\u0435\u0439, \u0434\u0430, \u0442\u043e \u0435\u0441\u0442\u044c, \u043d\u0443, \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u043f\u043e \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u043c \u043c\u0435\u0440\u043a\u0430\u043c \u0434\u043b\u044f \u0442\u043e\u043f\u043e\u0432\u043e\u0439 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u044b</mark>. \u041d\u043e \u043a\u0430\u043a \u0431\u044b, \u043a\u0430\u043a \u043e\u043d\u043e \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u0442, \u043f\u043e\u043a\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u043d\u0435 \u0441\u043e\u0432\u0441\u0435\u043c \u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u041d\u0443, \u0432\u043f\u043e\u043b\u043d\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0447\u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043e\u043d\u043e \u043f\u043e\u043a\u0430 \u043d\u0435 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u0442, \u043d\u043e \u0442\u043e, \u0447\u0442\u043e \u0435\u0433\u043e \u0445\u043e\u0442\u044f\u0442 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c, \u043d\u0443 \u0432\u0441\u043b\u0443\u0445 \u0441\u043a\u0430\u0437\u0430\u043d\u043e. \u041f\u043e\u0447\u0435\u043c\u0443 \u0431\u044b \u043a\u0438\u0442\u0430\u0439\u0446\u044b \u0435\u043c\u0443 \u043d\u0435 \u043f\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0432 \u044d\u0442\u043e, \u043a\u043e\u0433\u0434\u0430 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0446\u044b \u044d\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438?</p>\n<p>[\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0422\u0443\u0442, \u043a\u0430\u043a \u0431\u044b, \u0437\u043d\u0430\u0435\u0448\u044c, \u044d\u0442\u043e \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u044d\u0442\u0443 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e \u0441\u0442\u0430\u0440\u043e\u0433\u043e \u0430\u043d\u0435\u043a\u0434\u043e\u0442\u0430 \u043f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e \u043d\u0443 \u0442\u0430\u043a \u0438 \u0432\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435. \u0414\u0430, \u0442\u043e \u0435\u0441\u0442\u044c \u043c\u044b \u0445\u043e\u0442\u0438\u043c \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c, \u043d\u0443 \u0438 \u0432\u044b \u0445\u043e\u0442\u0438\u0442\u0435 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u041d\u0443, \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u044d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e \u043c\u0435\u043d\u044f \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442 \u00ab\u0417\u0432\u0451\u0437\u0434\u043d\u044b\u0435 \u0432\u043e\u0439\u043d\u044b\u00bb, \u043a\u043e\u0433\u0434\u0430 \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433\u043e\u0432\u0430\u044f \u0430\u043a\u0446\u0438\u044f, \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435, \u043a\u0430\u043a \u043c\u044b \u0441\u0442\u0440\u0430\u0448\u043d\u043e \u0431\u043e\u0440\u0435\u043c\u0441\u044f \u0441 \u00ab\u043f\u0440\u043e\u00bb, \u0430 \u043a\u0430\u043a\u043e\u0435 \u0443 \u043d\u0430\u0441 \u043a\u043b\u0451\u0432\u043e\u0435 \u00ab\u043f\u0440\u043e\u00bb, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e, \u043f\u0440\u0438\u0432\u0435\u043b\u043e \u043a, \u0432 \u043e\u0431\u0449\u0435\u043c, \u043f\u0435\u0440\u0435\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0412\u041f\u041a \u0438 \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season1/ep5.md#1477", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 24:37 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1477", "citation_number": 12, "order": 13}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21165: \u0412\u044b\u0448\u043b\u0430 GPT5 \u00b7 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442\u0430 \u00b7 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0437\u0430\u0441\u0442\u0443\u043a\u0430\u043b\u0438 \u043d\u0430 \u0442\u043e\u0440\u0440\u0435\u043d\u0442\u0430\u0445 \u00b7 24:37 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge5.mp3#t=1477"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[31:15] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0423 \u043d\u0430\u0441 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c, \u043e\u043d\u0430 \u0442\u0430\u043a\u0430\u044f. \u0411\u0443\u0434\u0435\u043c \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u044d\u0442\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0438\u043d\u043e\u0447\u043d\u043e\u0439. \u041d\u0430\u043c \u043d\u0443\u0436\u043d\u043e \u043e\u0442\u0432\u043b\u0435\u0447\u044c\u0441\u044f \u043e\u0442 \u0442\u0430\u043a\u0438\u0445 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432, \u043a\u0430\u043a \u043c\u044b. \u0420\u0430\u0437\u043c\u0438\u043d\u043e\u0447\u043d\u0430\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u044c \u0442\u0430\u043a\u0430\u044f, \u0447\u0442\u043e <mark>NVIDIA</mark> \u0432\u044b\u043f\u0443\u0441\u0442\u0438\u043b\u0430 DGX Station. \u042d\u0442\u043e, \u043e\u043f\u044f\u0442\u044c \u0436\u0435, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u043d\u0435 \u0432\u0441\u0435 \u0432 \u043a\u0443\u0440\u0441\u0435, \u043d\u043e \u0443 <mark>NVIDIA</mark> \u0435\u0441\u0442\u044c \u0446\u0435\u043b\u0430\u044f \u043b\u0438\u043d\u0435\u0439\u043a\u0430 \u0442\u0430\u043a\u0438\u0445 \u0431\u043e\u043b\u044c\u0448\u0438\u0445, \u043e\u0447\u0435\u043d\u044c \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0442\u043e\u044f\u0442 \u043e\u0447\u0435\u043d\u044c \u043c\u043d\u043e\u0433\u043e \u0434\u0435\u043d\u0435\u0433. \u041e\u043d\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f DGX, \u0434\u0430, \u0442\u0430\u043c \u043f\u043e \u0432\u043e\u0441\u0435\u043c\u044c \u043a\u0430\u0440\u0442\u043e\u0447\u0435\u043a. \u041a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u043d\u0443, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u0441\u0430\u043c\u044b\u0445 \u0442\u043e\u043f\u043e\u0432\u044b\u0445, \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u044b\u0445 \u0442\u0430\u043c \u0441\u0443\u043f\u0435\u0440 \u0442\u043e\u043f\u043e\u0432\u044b\u043c \u0436\u0435\u043b\u0435\u0437\u043e\u043c, \u0432\u0441\u0451 \u0443 \u043d\u0438\u0445 \u0442\u043e\u043f\u043e\u0432\u043e\u0435. \u0418 \u044d\u0442\u0430 \u0448\u0442\u0443\u043a\u0430 \u0441\u0442\u043e\u0438\u0442 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u043a\u0430\u043a \u043a\u0440\u044b\u043b\u043e \u043e\u0442 \u0441\u0430\u043c\u043e\u043b\u0451\u0442\u0430. \u0418 \u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u0447\u0442\u043e \u043d\u0435 \u0432\u0441\u0435 \u0441\u0435\u0431\u0435 \u0442\u0430\u043a\u043e\u0435 \u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c, \u0430 \u0432 \u043d\u0430\u0448\u0435\u0439 \u0441\u0442\u0440\u0430\u043d\u0435 \u0438 \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u043d\u0430\u0445 \u0435\u0433\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u0434\u0430\u0436\u0435 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0441\u0442\u0438. \u0422\u043e \u0435\u0441\u0442\u044c, \u043d\u0435\u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043d\u0430\u0432\u0435\u0440\u043d\u044f\u043a\u0430 \u043c\u043e\u0436\u043d\u043e, \u043d\u043e \u044d\u0442\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043a\u0430\u043a\u0438\u0445-\u0442\u043e \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u0432 \u0442\u0435\u043b\u043e\u043f\u0440\u0435\u0436\u0438\u0432\u043a\u0435. \u0412\u043e\u0442. \u0410 \u0442\u0443\u0442 \u043e\u043d\u0438, \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u043f\u043e\u0448\u043b\u0438 \u043d\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0447\u0430\u044f\u043d\u043d\u044f\u043c \u0438 \u0432\u044b\u043f\u0443\u0441\u0442\u0438\u043b\u0438 DGX Station. \u041a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u044f\u0442\u044c \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u043e\u0434 \u0441\u0442\u043e\u043b\u043e\u043c. \u0414\u0430, \u0442\u043e \u0435\u0441\u0442\u044c, \u043c\u044b \u0442\u0430\u043c \u0443 \u0441\u0435\u0431\u044f \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438, \u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043c\u0438\u043d\u0438-data center \u043f\u043e\u0434 \u0441\u0442\u043e\u043b\u043e\u043c. \u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044d\u0442\u043e \u0445\u043e\u0440\u043e\u0448\u043e \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e, \u044f \u043d\u0435 \u043c\u043e\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u043d\u043e \u043c\u043e\u0439 \u043e\u043f\u044b\u0442. \u041a\u0430\u043a \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0436\u0435 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 20 \u043b\u0435\u0442, \u044f \u043c\u043e\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0442\u0430\u043a, \u0447\u0442\u043e \u044f \u0441\u0430\u043c \u0432\u0438\u0434\u0435\u043b \u0441\u0435\u0440\u0432\u0435\u0440\u0430 \u043f\u043e\u0434 \u0441\u0442\u043e\u043b\u043e\u043c \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u0434\u0432\u0443\u0445\u0442\u044b\u0441\u044f\u0447\u043d\u044b\u0445, \u044f \u0432\u0438\u0434\u0435\u043b \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435 \u0434\u0432\u0443\u0445\u0442\u044b\u0441\u044f\u0447\u043d\u044b\u0445, \u0432 \u043a\u043e\u043d\u0446\u0435 \u0434\u0432\u0443\u0445\u0442\u044b\u0441\u044f\u0447\u043d\u044b\u0445 \u0434\u0435\u0441\u044f\u0442\u044b\u0445 \u044f \u0438\u0445 \u0432\u0438\u0434\u0435\u043b, \u044f \u0434\u0443\u043c\u0430\u044e, \u0431\u0443\u0434\u0443 \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0438 \u0434\u0430\u043b\u044c\u0448\u0435. \u0412 \u043e\u0431\u0449\u0435\u043c, \u043d\u0438\u043a\u0443\u0434\u0430 \u043c\u044b \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u043d\u0435 \u0443\u0439\u0434\u0451\u043c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043c\u0430\u043b\u043e\u043c\u0443 \u0431\u0438\u0437\u043d\u0435\u0441\u0443 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0435\u0441\u0442\u044c \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u044c \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432 \u043d\u0430\u0448\u0435 \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a\u0438\u043c-\u0442\u043e \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u043a\u0430\u0440\u0442\u043e\u0447\u0435\u043a.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u041d\u0443, \u0432\u043e-\u043f\u0435\u0440\u0432\u044b\u0445, \u043f\u043e \u0441\u043b\u0443\u0445\u0430\u043c, \u0443 \u044d\u0442\u043e\u0439 \u0448\u043a\u043e\u043b\u044b \u0435\u0441\u0442\u044c \u0430\u0436 200 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0448\u0442\u0443\u043a, \u0438 DGX, \u0438 \u043d\u0438\u0445 \u044d\u0442\u043e \u0436\u0435. \u041d\u0435 \u0437\u043d\u0430\u044e, \u0447\u0442\u043e \u043c\u044b \u0435\u0449\u0451 \u043d\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438, \u043a\u0430\u043a \u043c\u044b \u0438\u0445 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438. \u041c\u044b \u0438\u0445 \u043d\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438, \u043a\u0430\u043a \u043c\u044b \u0438\u0445 \u043e\u0442\u0442\u0443\u0434\u0430 \u0432\u043d\u0435\u0441\u0451\u043c, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0435\u043c \u043f\u043e\u043a\u0430 \u0447\u0442\u043e \u0436\u0434\u0430\u0442\u044c. \u0422\u0430\u043a \u0432\u043e\u0442. \u0410 \u0447\u0442\u043e \u044f \u0445\u043e\u0447\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0432 \u0431\u0430\u0439\u0432\u0435\u0440\u0435 \u0443 \u043c\u043d\u043e\u0433\u0438\u0445 \u0432 \u043f\u043e\u0434\u0432\u0430\u043b\u0435 \u0441\u0442\u043e\u0438\u0442 DGX. \u0422\u043e \u0435\u0441\u0442\u044c, \u043d\u0430\u0440\u043e\u0434 \u0434\u0430\u0432\u043d\u043e \u044d\u0442\u0443 \u0448\u0442\u0443\u043a\u0443 \u0434\u0435\u043b\u0430\u0435\u0442. \u041c\u043d\u0435 \u0432\u043e\u0442 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435, \u0447\u0442\u043e \u043d\u0435\u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u0434\u043b\u044f inference DGX \u0438\u0437\u043b\u0438\u0448\u043d\u0438\u0439 \u2014 \u044d\u0442\u043e \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u044b MacBook Pro \u0431\u0443\u0434\u0435\u0442 \u0434\u0435\u0448\u0435\u0432\u043b\u0435 \u0438 \u043b\u0443\u0447\u0448\u0435. \u0410 \u0443\u0447\u0438\u0442\u044c <mark>\u043c\u043e\u0434\u0435\u043b\u044c\u043a\u0438</mark> \u0432 \u043d\u0430\u0448\u0435 \u0432\u0440\u0435\u043c\u044f \u2014 \u044d\u0442\u043e \u0442\u0430\u043a\u043e\u0439 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u043d\u044b\u0439 \u0446\u0435\u043d\u0438\u0442\u0435\u043b\u044c, \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season2/ep5.md#1875", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 31:15 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=1875", "citation_number": 15, "order": 20}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 31:15 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=1875"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[33:28] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0418\u0437\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u0439 \u0446\u0435\u043d\u0438\u0442\u0435\u043b\u044c \u2014 \u0434\u0430, \u043d\u043e \u0442\u0443\u0442 \u0436\u0435 \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u043f\u0440\u043e DGX Station, \u0442\u043e \u0435\u0441\u0442\u044c Mac Book, \u043d\u0435 Mac Book, pardon, \u0430 \u044d\u0442\u0438\u0445, \u043a\u0430\u043a \u043e\u043d\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f, Mac Mini, \u043f\u043e-\u043c\u043e\u0435\u043c\u0443, \u0434\u0430, Mac Mini \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u0443\u043f\u0435\u0440\u043f\u043e\u043a\u0443\u043b\u044f\u0440\u043d\u0430\u044f, \u043a\u0430\u043a inference. \u0414\u0430-\u0434\u0430-\u0434\u0430, \u0438 \u043d\u0443 \u0438\u0445 \u043d\u0430 \u0432\u0441\u0435\u0445 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u041a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430, \u0432\u0441\u0435\u0433\u043e \u043d\u0430 \u0432\u0441\u0435\u0445 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u0412\u043e\u0442 DGX, \u0434\u0430-\u0434\u0430, \u0432\u043e\u0442 \u0435\u0441\u0442\u044c DGX, \u0438 \u043f\u0440\u043e \u043f\u0430\u043c\u044f\u0442\u044c \u0443 \u043d\u0430\u0441 \u0431\u0443\u0434\u0435\u0442. \u041d\u043e\u0432\u043e\u0441\u0442\u044c \u044d\u0442\u0430 \u043a\u0430\u043a \u0440\u0430\u0437 \u043e\u0447\u0435\u043d\u044c \u0432\u0430\u0436\u043d\u0430, \u043c\u044b \u0441\u0435\u0439\u0447\u0430\u0441 \u044d\u0442\u043e \u043e\u0431\u0441\u0443\u0434\u0438\u043c. \u0412\u043e\u0442 \u043f\u043e\u044d\u0442\u043e\u043c\u0443 DGX, \u043d\u0430 \u043c\u043e\u0439 \u0432\u0437\u0433\u043b\u044f\u0434, \u0442\u043e\u0436\u0435 \u0432\u043f\u043e\u043b\u043d\u0435 \u0441\u0435\u0431\u0435 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u044c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0442\u0430\u043c \u043f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0435\u0431\u0435 \u0441\u0442\u043e\u0439\u043a\u0443 \u0438\u0437 Mac Mini \u043d\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u043c\u043e\u0436\u0435\u0442, \u0441\u0443\u043c\u0435\u0435\u0442 \u0442\u0443\u0434\u0430-\u0441\u044e\u0434\u0430, \u0430 DGX \u043a\u0443\u043f\u0438\u0442\u044c \u043a\u043e\u043c\u0443-\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u043f\u043e\u043d\u044f\u0442\u043d\u0435\u0435. \u041a\u0430\u043a\u0430\u044f \u0442\u0430\u043c \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c? \u0427\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u044f\u0442? \u0427\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u0442\u0430\u043c \u043d\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0430, \u0438 \u044f \u043f\u043e\u0437\u0430\u0440\u0438\u0432\u0430\u044e, \u0447\u0442\u043e \u043e\u043d\u0430, \u043a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430, \u0443\u0437\u043d\u0430\u0451\u0442\u0441\u044f \u043f\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0443. \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u0440\u044b\u043d\u043a\u0435, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0432\u0441\u0451-\u0442\u0430\u043a\u0438 \u043d\u0435 \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0441\u044f \u043f\u043e \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u0438.</p>\n<p>[\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432] \u0412\u043e\u043e\u0431\u0449\u0435 \u0437\u0432\u0443\u0447\u0438\u0442, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043a\u0440\u0430\u0441\u0438\u0432\u043e. \u041d\u0435 \u0441\u043c\u043e\u0433 \u043a\u0443\u043f\u0438\u0442\u044c Mac Mini \u0438 \u0447\u0442\u043e-\u0442\u043e, x.</p>\n<p>[\u0422\u0438\u043c\u0443\u0440 \u041c\u0430\u0434\u0436\u0438\u0434\u043e\u0432] \u041d\u0443, \u0443 \u043c\u0435\u043d\u044f DGX, \u0434\u0430, \u0432\u043e\u0442 \u0442\u0430\u043a, \u0445\u0430-\u0445\u0430, \u043d\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435. Malyutin, \u043f\u0440\u0430\u0432\u0434\u0430, \u0443 \u043c\u0435\u043d\u044f \u0442\u043e\u0436\u0435 \u0431\u044b\u043b \u043e\u043f\u044b\u0442, \u0447\u0442\u043e \u0432\u0441\u0435\u0433\u0434\u0430, \u0434\u0430\u0436\u0435 \u043f\u0440\u0438 \u0442\u043e\u043c, \u0447\u0442\u043e \u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0431\u044b\u043b\u0438 \u0441\u043d\u044f\u0442\u044b \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u043e\u0431\u043b\u0430\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u044b \u0441 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u0430\u043c\u0438</mark>. \u0421 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u043c\u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0432 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439 \u0443 \u043d\u0430\u0441 \u0441\u0442\u043e\u044f\u043b\u0430 \u043f\u043e\u0434 \u0441\u0442\u043e\u043b\u043a\u0430 \u0441\u0432\u043e\u044f. \u041d\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u044f \u0432\u0438\u0436\u0443 \u0442\u0440\u0435\u043d\u0434, \u043d\u0443, \u0432\u0432\u0438\u0434\u0443 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430, \u043f\u043e\u043d\u044f\u0442\u043d\u043e\u0435 \u0434\u0435\u043b\u043e, \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u043f\u043e\u043a\u0443\u043f\u0430\u044e\u0442. GPUs \u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043b\u044f \u0438\u0433\u0440, \u0434\u0430, \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u044b \u0442\u0430\u043c, \u043d\u0443 \u0432 \u043e\u0431\u0449\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u044b \u043d\u0435 \u0434\u043b\u044f \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f. \u0418\u0445 \u0445\u0430\u043a\u0430\u044e\u0442, \u0441\u0442\u0430\u0432\u044f\u0442 \u0441\u0435\u0431\u0435 \u0441\u0442\u043e\u0439\u043a\u0443, \u043d\u0430 \u043d\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442. \u0422\u044b \u043f\u043e\u0441\u043e\u0431\u0438\u0435 \u0438\u043c\u0435\u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435.</p>\n<p>[\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0422\u0430\u043a\u0438\u0435 \u043a\u0430\u0440\u0442\u044b \u0442\u043e\u0436\u0435 \u043f\u0440\u043e\u043f\u0430\u043b\u0438, \u043f\u0430\u043c\u044f\u0442\u0438 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u0447\u0438\u043f\u043e\u0432 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u043c\u0443 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u044c DGX. \u041d\u0443 \u0434\u0430, \u0438\u043b\u0438 \u0442\u0430\u043c Jetson Nano \u0438\u043b\u0438 \u0447\u0442\u043e-\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0432 \u0432\u0438\u0434\u0435 \u0444\u043b\u0435\u0448\u043a\u0438. \u0422\u0430\u043a, \u0447\u0442\u043e \u0442\u0443\u0442 \u043a\u0442\u043e-\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u0441\u043f\u0440\u043e\u0441\u0438\u0442\u044c, \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season2/ep5.md#2008", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 33:28 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432, \u0422\u0438\u043c\u0443\u0440 \u041c\u0430\u0434\u0436\u0438\u0434\u043e\u0432", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=2008", "citation_number": 16, "order": 21}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 33:28 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432, \u0422\u0438\u043c\u0443\u0440 \u041c\u0430\u0434\u0436\u0438\u0434\u043e\u0432", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=2008"}}}}

data: {"event": {"type": "citation", "data": {"document": ["<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>body{background:#fff;color:#1a1a1a;margin:0;padding:10px;font:14px/1.5 system-ui,-apple-system,sans-serif}h1,h2,h3,h4{margin:.5em 0 .2em;color:#000}h1{font-size:1.25em}h2{font-size:1.15em}h3{font-size:1.05em}p{margin:.3em 0}ul,ol{margin:.3em 0;padding-left:1.4em}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;padding:3px 6px}th{background:#eee}code{background:#f0f0f0;padding:1px 3px;font:.9em monospace}mark{background:#fff3a0}a{color:#0a58ca}</style></head><body><p>[38:30] [\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u0412\u043e\u043e\u0431\u0449\u0435, \u0440\u0435\u0430\u043b\u044c\u043d\u043e, \u044d\u0442\u043e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u043e\u043f\u0440\u043e\u0441, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u0442\u0430\u043a\u0438\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 <mark>\u043c\u043e\u0434\u0435\u043b\u0438</mark> \u0443\u0447\u0430\u0442\u0441\u044f \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043f\u043b\u0430\u0441\u0442\u0435\u0440\u0430\u0445, \u0442\u0430\u043c, \u0433\u0434\u0435 \u0442\u044b\u0441\u044f\u0447\u0438 <mark>\u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442</mark>, \u043d\u0435 \u0432\u043e\u0441\u0435\u043c\u044c, \u043a\u0430\u043a \u0432 DGX-1, \u0430 \u0442\u044b\u0441\u044f\u0447\u0438 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c <mark>\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435</mark> \u0438 \u0435\u0433\u043e \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u044c. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u0431\u0443\u0447\u0430\u0442\u044c \u0442\u0430\u043a\u0443\u044e \u0431\u043e\u043b\u044c\u0448\u0443\u044e <mark>\u043c\u043e\u0434\u0435\u043b\u044c</mark>, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0441\u044f. \u041d\u043e \u0435\u0441\u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e, \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c, \u043c\u044b \u0434\u0435\u043b\u0430\u0435\u043c, \u0443 \u043d\u0430\u0441 \u0432 \u0442\u0430\u043a\u0438\u0445 \u0441\u0444\u0435\u0440\u0430\u0445 \u043c\u044b \u043e\u0431\u0443\u0447\u0430\u0435\u043c <mark>\u043c\u043e\u0434\u0435\u043b\u0438</mark>. \u0420\u0430\u0437\u043c\u0435\u0440\u043e\u043c 32 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u0430 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432. \u041c\u044b \u0434\u043e \u043e\u0431\u0443\u0447\u0430\u0435\u043c, \u043d\u0435 \u0441 \u043d\u0443\u043b\u044f, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043d\u043e \u0438 \u0441 \u043d\u0443\u043b\u044f \u0442\u043e\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u043e\u0431\u0443\u0447\u0438\u0442\u044c. \u041f\u0440\u043e\u0441\u0442\u043e \u044d\u0442\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0434\u043e\u043b\u0433\u043e, \u0442\u043e \u0435\u0441\u0442\u044c, \u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u043c\u0438\u043d\u0438\u043c\u0443\u043c, \u0434\u043b\u044f <mark>\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f</mark> <mark>\u043c\u043e\u0434\u0435\u043b\u0438</mark> \u0441 \u043d\u0443\u043b\u044f. \u0412\u043e\u0442, \u0442\u043e \u0435\u0441\u0442\u044c, \u0432 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435, \u044f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u044d\u0442\u0438 DGX, \u043e\u043d\u0438 \u0441\u043a\u043e\u0440\u0435\u0435 \u043f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e\u0431\u044b \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438, \u0434\u0430, \u0443 \u0441\u0435\u0431\u044f \u0432 \u0433\u0430\u0440\u0430\u0436\u0435. \u041d\u0443, \u043a\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0441\u0435\u0431\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, DGX \u0432 \u0433\u0430\u0440\u0430\u0436\u0435 \u0445\u0440\u0430\u043d\u0438\u0442\u044c, \u043d\u043e \u0442\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435. \u0422\u0430\u043a \u043e\u043d\u0438 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u044e\u0442\u0441\u044f \u0432 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0443\u0447\u0430\u0442\u0441\u044f DGX \u0447\u0435\u0442\u044b\u0440\u0435 \u0441 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u043e\u0439, \u043f\u044f\u0442\u044c, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u0433\u043e\u0434\u043d\u043e.</p>\n<p>[\u0422\u0438\u043c\u0443\u0440 \u041c\u0430\u0434\u0436\u0438\u0434\u043e\u0432] \u041d\u0443, \u043a\u0441\u0442\u0430\u0442\u0438, \u044f \u0434\u0443\u043c\u0430\u044e, \u0432\u043e\u0442 \u044d\u0442\u0438 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 DGX, \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u043f\u043e\u0434\u0441\u0442\u043e\u043b\u044c\u043d\u044b\u0435, \u0442\u043e\u0447\u043d\u043e \u0434\u043b\u044f \u0434\u0430\u0442\u044e\u043d\u0430 \u0445\u0432\u0430\u0442\u0438\u0442. \u0422\u0430\u043c LoRA tuning \u0438\u043b\u0438 \u043d\u0435\u043c\u043d\u043e\u0436\u043a\u043e \u0440\u0430\u0437\u043c\u043e\u0440\u043e\u0437\u0438\u0442\u044c \u0441\u043b\u043e\u0451\u0432 \u0434\u043b\u044f \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430 <mark>\u043c\u043e\u0434\u0435\u043b\u044c</mark>, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e \u0434\u043b\u044f \u0430\u0433\u0435\u043d\u0442\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c, \u0442\u0430\u043c, 30B, \u043d\u0430\u0432\u0435\u0440\u043d\u044f\u043a\u0430 \u0434\u0430\u0442\u044e\u043d\u0438\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u0431\u0443\u0434\u0435\u0442. \u0414\u0430, \u0430 \u044f \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u044e \u0443\u0436\u0435 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e...</p>\n<p>[\u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445] \u041d\u0435\u0442, \u0434\u043e\u0442\u044e\u043d\u0438\u0442\u044c, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043d\u043e \u0442\u0443\u0442 \u0432\u043e\u043f\u0440\u043e\u0441 \u0431\u044b\u043b \u0438\u043c\u0435\u043d\u043d\u043e \u043f\u0440\u043e <mark>\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435</mark> \u0441 \u043d\u0443\u043b\u044f.</p>\n</body></html>"], "metadata": [{"source": "local:podcast:season2/ep5.md#2310", "name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 38:30 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0422\u0438\u043c\u0443\u0440 \u041c\u0430\u0434\u0436\u0438\u0434\u043e\u0432", "html": true, "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=2310", "citation_number": 17, "order": 24}], "source": {"name": "\u041a\u0430\u043f\u0438\u0442\u0430\u043d\u0441\u043a\u0438\u0439 \u043c\u043e\u0441\u0442\u0438\u043a \u21162-5: \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438 \u0434\u043b\u044f \u0418\u0418 \u0441\u043e \u0441\u0432\u0430\u043b\u043a\u0438 \u00b7 \u043a\u043e\u0441\u043c\u043e-\u0418\u0418 \u043e\u0442 \u0418\u043b\u043e\u043d\u0430 \u041c\u0430\u0441\u043a\u0430 \u00b7 NeurIPS \u0431\u0435\u0437 \u043a\u043e\u0434\u0430 \u00b7 38:30 \u00b7 \u0412\u0430\u043b\u0435\u043d\u0442\u0438\u043d \u041c\u0430\u043b\u044b\u0445, \u0422\u0438\u043c\u0443\u0440 \u041c\u0430\u0434\u0436\u0438\u0434\u043e\u0432", "url": "https://kolodezev.ru/download/data-capitan/captainsbridge2-5.mp3#t=2310"}}}}

