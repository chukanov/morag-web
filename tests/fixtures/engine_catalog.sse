data: {"id": "morag-audio-915a5e42-74f9-4206-a3e5-8c595de3accc", "object": "chat.completion.chunk", "created": 1784962425, "model": "morag-audio", "choices": [{"index": 0, "delta": {"content": "\u0432\u043e\u0434\u0438\u0442 \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0438\u043d\u0432\u0435\u0441\u0442\u043e\u0440\u043e\u0432 \u0438 \u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0446\u0438\u0438. \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043b \u044d\u0442\u0443 \u043c\u044b\u0441\u043b\u044c, \u043e\u0442\u043c\u0435\u0442\u0438\u0432, \u0447\u0442\u043e \u0442\u0430\u043a\u0438\u0435 \u043e\u0442\u0447\u0435\u0442\u044b \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0430\u0436\u0438\u043e\u0442\u0430\u0436, \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0433\u043d\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0442\u0440\u0435\u043d\u0434\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u0449\u0435 \u043d\u0435 \u0441\u0442\u0430\u043b\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\u0427\u0442\u043e \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u041c\u0430\u0440\u043a\u0430 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430, \u0442\u043e \u0433\u043e\u0441\u0442\u0438 \u0441\u043e\u0448\u043b\u0438\u0441\u044c \u0432\u043e \u043c\u043d\u0435\u043d\u0438\u0438, \u0447\u0442\u043e \u0440\u044b\u043d\u043e\u043a \u043e\u0442\u0440\u0435\u0430\u0433\u0438\u0440\u043e\u0432\u0430\u043b \u043d\u0430 \u043d\u0435\u0433\u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e \u2014 \u00ab\u043e\u0442 \u0426\u0443\u043a\u0435\u0440\u0431\u0435\u0440\u0433\u0430 \u0440\u0430\u0437\u0431\u0435\u0433\u0430\u044e\u0442\u0441\u044f \u043b\u044e\u0434\u0438\u00bb. \u041c\u0430\u043b\u044b\u0445 \u0438 \u041a\u043e\u043b\u043e\u0434\u0435\u0437\u0435\u0432 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0438,"}, "logprobs": null, "finish_reason": null}]}

