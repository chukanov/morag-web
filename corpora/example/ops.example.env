# Операционные настройки корпуса для инструментов (`tools/spaces.py::ops_env`; переменные
# окружения перекрывают). Хозяйство ЭТОГО корпуса: где видео, файл стека транскрибации,
# порядок веток в прогонах. Секретов здесь нет и быть не должно.
ASR_STACK_ENV=~/.asr-stack.env
# Сервер с архивом видео (rsync/ssh); пусто — видео только локальные файлы.
VIDEO_HOST=
VIDEO_ARCHIVE=
# Второй корень: файлы, чей `media:` в шапке начинается с VIDEO_WEB_PREFIX, лежат не в архиве,
# а здесь (например, вложения прежнего сайта в его каталоге). Пусто — всё из архива.
VIDEO_WEB_ROOT=
VIDEO_WEB_PREFIX=
# Ветки в порядке обработки экрана: сначала те, где слайды.
VIDEO_ORDER=Доклады,Встречи,Курсы
