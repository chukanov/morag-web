# Профиль корпуса для конвейера транскрибации morag (services/asr-adaptor) — ПРИМЕР.
# Подхватывается строкой ASR_PROFILE=<путь к этому файлу> в машинном ~/.asr-stack.env.
# ⚠️ Читает ПРОЦЕСС адаптера при старте: после правки — рестарт стека (stack.sh down && up).
# Здесь — то, что влияет на КАЧЕСТВО и одинаково на любой машине; адреса, ключи, слоты и
# пути — в машинном файле (0600, вне git). Секретов здесь нет и быть не должно.

# Что за материал: одна строка в родительном падеже, единственное число — встаёт в промпты
# стадий («расшифровку фрагмента …», «Тебе дано НАЧАЛО …»).
ASR_CORPUS_DESC="записи внутренней встречи: доклада, демо или собрания команды"
# Постоянные термины корпуса — в подсказку ASR всегда и первыми. Правило: термин заводится
# после ВТОРОГО промаха глоссария, а не по догадке. В кавычках: файл читается через source.
ASR_ALWAYS_TERMS="Kafka, Postgres, Grafana"
ASR_MIN_SPEAKERS=1
ASR_MAX_SPEAKERS=20
# Наминг голосов LLM выключен: имена ставят люди (словарь имён и «это я» на сайте).
ASR_ENABLE_NAMING=0
ASR_GUARD_NAMES=1
# Порог совпадения голоса с реестром: 0.7, а не движковый 0.55 — ложный матч подписал бы
# докладчика чужим именем, и цена ошибки необратима.
ASR_MATCH_THRESHOLD=0.7
ASR_MIN_GUEST_MIN=0.25
ASR_ENABLE_ALIGN=1
