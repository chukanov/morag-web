#!/bin/sh
# Сторож перед push: репозиторий корпуса, лежащий рядом, знает, какие слова — данные компании
# (имена, гарблы, внутренние системы, маркеры), и умеет сканировать этот чекаут целиком
# (`tools/leak_check.py --web --root <этот репозиторий>`). Здесь такого списка нет и быть не
# может — он сам был бы утечкой. Поэтому хук ищет соседей с таким инструментом и зовёт каждого;
# ненулевой код — push не уходит. Соседа нет (чистый клон платформы) — хук молчит.
#
# Включить один раз в клоне: git config core.hooksPath deploy/git-hooks
# Обойти осознанно:          git push --no-verify   (и ответить себе, почему)
set -e
here=$(cd "$(dirname "$0")/../.." && pwd)
found=0
for guard in "$here"/../*/tools/leak_check.py; do
  [ -f "$guard" ] || continue
  repo=$(cd "$(dirname "$guard")/.." && pwd)      # нормализованный путь: иначе «../» прячет соседа под нашим
  [ "$repo" = "$here" ] && continue
  found=1
  echo "pre-push: сторож $repo → --web --root $here"
  if ! python3 "$guard" --web --root "$here"; then
    echo "pre-push: сторож нашёл данные корпуса — push отменён" >&2
    exit 1
  fi
done
[ "$found" = 1 ] || echo "pre-push: репозитория корпуса со сторожем рядом нет — проверка пропущена"
